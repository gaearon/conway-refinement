/-!
# Germs of translated truncations: the ring of series

The ring of series `A` is a polynomial ring over the subalgebra of series all of whose germs are
constants.

`SeriesTruncationGerms` adds to `TruncationGerms` the axioms that make `A` behave like a ring of
generalised power series with nonpositive well-ordered support: a series is determined by its
germs at all exponents; truncations `b_{|η}` exist (they keep the germs at exponents `≤ η` and kill
the others); multiplication by a monomial `t^γ`, `γ ≤ 0`, translates germs; and the set of
exponents at which a series has a nonzero germ is well-founded and contains a greatest element
below each bound at which it is nonempty.

For a subalgebra `S` of the ring of germs, `seriesWithGermsIn S` is the subalgebra of series all of
whose germs lie in `S`, and `seriesWithConstantGerms = seriesWithGermsIn ⊥` is the subalgebra of
series all of whose germs are constants. The main theorem
`exists_algebraicIndependent_series_generators` presents `A` as a polynomial ring over
`seriesWithConstantGerms`.

The proof is a Zorn argument on algebraically independent sets `𝒳` of series such that the
subalgebra `R` generated by the constant-germ series and `𝒳` is closed under truncation and has its
germs in `S = K[germ '' 𝒳]`. For a maximal `𝒳`, closure under truncation and a well-founded
induction on the exponents give `R = seriesWithGermsIn S`. If `S` were not the whole ring of
germs, a germ of minimal rank outside `S` would be represented by a series `X` whose germs at
negative exponents lie in `S`. Since `Q` is an integral domain (`TruncationGerms.isDomain`), so
is `S`, and by `TruncationGerms.transcendental_germ`, `germ X` is transcendental over `S`.
Comparing top germs then shows that `X` is transcendental over `R`, and adjoining `X` preserves
closure under truncation, contradicting maximality.
-/

universe u w

public section

/-- Germs of translated truncations on a ring `A` of series, satisfying the further axioms of
generalised power series with nonpositive well-ordered support: extensionality in the germs,
truncations, monomials that translate germs, and well-ordered germ supports that have greatest
elements below each bound. -/
@[blueprint "def:series-germ-axioms"
  (phase := "Polynomial presentations")
  (title := "Axioms for germs on a ring of series")
  (statement := /--
    A system of germs $(g_\gamma)$ on $A$ with values in $Q$
    (\ref{def:germ-axioms}) is a system of germs on a ring of series if
    moreover, for all $b\in A$:
    \begin{itemize}
      \item (8) if $g_\xi(b)=0$ for every $\xi$, then $b=0$;
      \item (9) for every $\eta\in\Gamma$ there is $b_{|\eta}\in A$ with
        $g_\xi(b_{|\eta})=g_\xi(b)$ for $\xi\le\eta$ and $g_\xi(b_{|\eta})=0$ for
        $\xi>\eta$;
      \item (10) for every $\gamma\le0$ there is $t^\gamma\in A$ with
        $g_\xi(t^\gamma c)=g_{\xi-\gamma}(c)$ for all $c\in A$ and all $\xi$;
      \item (11) the set $\{\xi:g_\xi(b)\ne0\}$ is well-founded, and each nonempty
        intersection of it with a ray $(-\infty,\varepsilon]$ has a greatest
        element.
    \end{itemize}
    For a $K$-subalgebra $S\subseteq Q$ write $A_S$ for the $K$-subalgebra of
    series all of whose germs lie in $S$; thus $A_K$ consists of the series all
    of whose germs are constants.  A $K$-subalgebra of $A$ is closed under
    truncation if it contains $b_{|\eta}$ whenever it contains $b$.
  -/)
  (proof := /--
    These axioms extend those of a system of germs by the properties of
    $K((\mathbb R^{\le0}))$ that concern series rather than germs: a series is
    determined by its germs, truncations and monomials act on germs as stated,
    and the exponents with nonzero germ form the closure of the support.
  -/)]
structure SeriesTruncationGerms (K Γ A Q : Type*) [Field K] [CharZero K]
    [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
    [CommRing A] [Algebra K A] [CommRing Q] [Nontrivial Q] [Algebra K Q]
    extends TruncationGerms K Γ A Q where
  /-- A series all of whose germs vanish is zero. -/
  eq_zero_of_germAt : ∀ b : A, (∀ ξ, germAt ξ b = 0) → b = 0
  /-- The truncation of `b` at `η` keeps the germs at exponents `≤ η` and kills the others. -/
  exists_truncation : ∀ (b : A) (η : Γ), ∃ b' : A, ∀ ξ,
    germAt ξ b' = if ξ ≤ η then germAt ξ b else 0
  /-- A monomial `t^γ`, `γ ≤ 0`: multiplication by it translates germs by `γ`. -/
  exists_monomial : ∀ γ : Γ, γ ≤ 0 → ∃ m : A, ∀ (b : A) (ξ : Γ),
    germAt ξ (m * b) = germAt (ξ - γ) b
  /-- The set of exponents at which a series has a nonzero germ is well-founded. -/
  germSupport_isWF : ∀ b : A, {ξ | germAt ξ b ≠ 0}.IsWF
  /-- Each nonempty part of the germ support below a bound has a greatest element. -/
  germSupport_exists_max : ∀ (b : A) (ε : Γ), ({ξ | germAt ξ b ≠ 0} ∩ Set.Iic ε).Nonempty →
    ∃ ζ ∈ {ξ | germAt ξ b ≠ 0} ∩ Set.Iic ε, ∀ ξ ∈ {ξ | germAt ξ b ≠ 0} ∩ Set.Iic ε, ξ ≤ ζ

namespace SeriesTruncationGerms

variable {K Γ A Q : Type*} [Field K] [CharZero K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
  [CommRing A] [Algebra K A] [CommRing Q] [Nontrivial Q] [Algebra K Q]
  (sys : SeriesTruncationGerms K Γ A Q)

/-! ### Truncation -/

/-- Two series with the same germs at every exponent are equal. -/
theorem germAt_injective {b c : A} (h : ∀ ξ, sys.germAt ξ b = sys.germAt ξ c) : b = c :=
  sub_eq_zero.mp (sys.eq_zero_of_germAt (b - c) fun ξ => by rw [map_sub, h ξ, sub_self])

/-- A series has nonzero germs only at nonpositive exponents. -/
theorem nonpos_of_germAt_ne_zero {b : A} {ξ : Γ} (h : sys.germAt ξ b ≠ 0) : ξ ≤ 0 :=
  le_of_not_gt fun hξ => h (sys.germAt_of_pos b ξ hξ)

/-- The truncation `b_{|η}` of a series `b` at an exponent `η`. -/
noncomputable def truncation (b : A) (η : Γ) : A := Classical.choose (sys.exists_truncation b η)

theorem germAt_truncation (b : A) (η ξ : Γ) :
    sys.germAt ξ (sys.truncation b η) = if ξ ≤ η then sys.germAt ξ b else 0 :=
  Classical.choose_spec (sys.exists_truncation b η) ξ

theorem truncation_add (b c : A) (η : Γ) :
    sys.truncation (b + c) η = sys.truncation b η + sys.truncation c η := by
  refine sys.germAt_injective fun ξ => ?_
  rw [map_add, germAt_truncation, germAt_truncation, germAt_truncation, map_add]
  split_ifs <;> simp

theorem truncation_sub (b c : A) (η : Γ) :
    sys.truncation (b - c) η = sys.truncation b η - sys.truncation c η := by
  refine sys.germAt_injective fun ξ => ?_
  rw [map_sub, germAt_truncation, germAt_truncation, germAt_truncation, map_sub]
  split_ifs <;> simp

@[simp]
theorem truncation_zero (η : Γ) : sys.truncation (0 : A) η = 0 :=
  sys.germAt_injective fun ξ => by simp [germAt_truncation]

/-- A series without germs above `η` is its own truncation at `η`. -/
theorem truncation_eq_self (b : A) (η : Γ) (h : ∀ ξ, η < ξ → sys.germAt ξ b = 0) :
    sys.truncation b η = b := by
  refine sys.germAt_injective fun ξ => ?_
  rw [germAt_truncation]
  split_ifs with hξ
  · rfl
  · exact (h ξ (lt_of_not_ge hξ)).symm

theorem truncation_truncation (b : A) (η η' : Γ) :
    sys.truncation (sys.truncation b η) η' = sys.truncation b (min η η') := by
  refine sys.germAt_injective fun ξ => ?_
  simp only [germAt_truncation, le_min_iff]
  by_cases h1 : ξ ≤ η <;> by_cases h2 : ξ ≤ η' <;> simp [h1, h2]

/-- Truncations at `η ≤ η'` agree when `b` has no germs in `(η, η']`. -/
theorem truncation_eq_truncation (b : A) {η η' : Γ} (hle : η ≤ η')
    (h : ∀ ξ, η < ξ → ξ ≤ η' → sys.germAt ξ b = 0) :
    sys.truncation b η' = sys.truncation b η := by
  refine sys.germAt_injective fun ξ => ?_
  rw [germAt_truncation, germAt_truncation]
  by_cases h1 : ξ ≤ η
  · rw [if_pos h1, if_pos (h1.trans hle)]
  · rw [if_neg h1]
    by_cases h2 : ξ ≤ η'
    · rw [if_pos h2, h ξ (lt_of_not_ge h1) h2]
    · rw [if_neg h2]

/-- The truncation at `ε` equals the truncation at the greatest exponent `≤ ε` of the germ
support, or vanishes when there is none. -/
theorem truncation_eq_zero_or_exists (b : A) (ε : Γ) :
    sys.truncation b ε = 0 ∨ ∃ ζ ≤ ε, sys.germAt ζ b ≠ 0 ∧
      sys.truncation b ε = sys.truncation b ζ := by
  by_cases hns : ({ξ | sys.germAt ξ b ≠ 0} ∩ Set.Iic ε).Nonempty
  · obtain ⟨ζ, ⟨hζW, hζle⟩, hmax⟩ := sys.germSupport_exists_max b ε hns
    refine Or.inr ⟨ζ, hζle, hζW, sys.truncation_eq_truncation b hζle fun ξ hξlo hξhi => ?_⟩
    by_contra hne
    exact absurd (hmax ξ ⟨hne, hξhi⟩) (not_le.mpr hξlo)
  · refine Or.inl (sys.germAt_injective fun ξ => ?_)
    rw [germAt_truncation, map_zero]
    split_ifs with h
    · by_contra hne; exact hns ⟨ξ, hne, h⟩
    · rfl

/-- A nonzero series has a greatest exponent with nonzero germ. -/
theorem exists_max_germSupport {b : A} (hb : b ≠ 0) :
    ∃ η, sys.germAt η b ≠ 0 ∧ ∀ ξ, sys.germAt ξ b ≠ 0 → ξ ≤ η := by
  obtain ⟨ξ₀, hξ₀⟩ : ∃ ξ, sys.germAt ξ b ≠ 0 := by
    by_contra hc
    exact hb (sys.eq_zero_of_germAt b fun ξ => not_not.mp (not_exists.mp hc ξ))
  obtain ⟨ζ, ⟨hζW, _⟩, hmax⟩ := sys.germSupport_exists_max b 0
    ⟨ξ₀, hξ₀, sys.nonpos_of_germAt_ne_zero hξ₀⟩
  exact ⟨ζ, hζW, fun ξ hξ => hmax ξ ⟨hξ, sys.nonpos_of_germAt_ne_zero hξ⟩⟩

/-- A nonzero series is its truncation at its greatest exponent with nonzero germ. -/
theorem exists_truncation_eq_self {b : A} (hb : b ≠ 0) :
    ∃ η, sys.germAt η b ≠ 0 ∧ sys.truncation b η = b := by
  obtain ⟨η, hη, hmax⟩ := sys.exists_max_germSupport hb
  refine ⟨η, hη, sys.truncation_eq_self b η fun ξ hξ => ?_⟩
  by_contra hne
  exact absurd (hmax ξ hne) (not_le.mpr hξ)

/-! ### Series with germs in a subalgebra -/

/-- The subalgebra of series all of whose germs lie in a subalgebra `S` of the ring of germs. -/
def seriesWithGermsIn (S : Subalgebra K Q) : Subalgebra K A where
  carrier := {b | ∀ ξ, sys.germAt ξ b ∈ S}
  mul_mem' {b c} hb hc ξ := by
    rw [sys.convolution]; exact sys.finsum_convolution_mem S b c ξ hb hc
  one_mem' ξ := by
    rcases eq_or_ne ξ 0 with rfl | hξ
    · rw [sys.germAt_zero, map_one]; exact one_mem S
    · rw [← map_one (algebraMap K A), sys.germAt_algebraMap 1 ξ hξ]; exact zero_mem S
  add_mem' {b c} hb hc ξ := by rw [map_add]; exact add_mem (hb ξ) (hc ξ)
  zero_mem' ξ := by rw [map_zero]; exact zero_mem S
  algebraMap_mem' r ξ := by
    rcases eq_or_ne ξ 0 with rfl | hξ
    · rw [sys.germAt_zero, AlgHom.commutes]; exact Subalgebra.algebraMap_mem S r
    · rw [sys.germAt_algebraMap r ξ hξ]; exact zero_mem S

@[simp]
theorem mem_seriesWithGermsIn {S : Subalgebra K Q} {b : A} :
    b ∈ sys.seriesWithGermsIn S ↔ ∀ ξ, sys.germAt ξ b ∈ S := Iff.rfl

@[simp]
theorem seriesWithGermsIn_top : sys.seriesWithGermsIn (⊤ : Subalgebra K Q) = ⊤ :=
  eq_top_iff.mpr fun _ _ => sys.mem_seriesWithGermsIn.mpr fun _ => Algebra.mem_top

/-- The subalgebra of series all of whose germs are constants. -/
def seriesWithConstantGerms : Subalgebra K A := sys.seriesWithGermsIn ⊥

theorem mem_seriesWithConstantGerms {b : A} :
    b ∈ sys.seriesWithConstantGerms ↔ ∀ ξ, sys.germAt ξ b ∈ Set.range (algebraMap K Q) := by
  simp [seriesWithConstantGerms, Algebra.mem_bot]

theorem seriesWithConstantGerms_le (S : Subalgebra K Q) :
    sys.seriesWithConstantGerms ≤ sys.seriesWithGermsIn S :=
  fun _ hb ξ => (bot_le : (⊥ : Subalgebra K Q) ≤ S) (hb ξ)

/-- A subalgebra of series is closed under truncation if it contains the truncations of its
elements at every exponent. -/
def IsTruncationClosed (R : Subalgebra K A) : Prop :=
  ∀ b ∈ R, ∀ η : Γ, sys.truncation b η ∈ R

theorem isTruncationClosed_seriesWithGermsIn (S : Subalgebra K Q) :
    sys.IsTruncationClosed (sys.seriesWithGermsIn S) := by
  intro b hb η ξ
  rw [germAt_truncation]
  split_ifs
  · exact hb ξ
  · exact zero_mem S

/-! ### Top germs and monomials -/

/-- If `u` has no germs above `η`, the germ of `u * c` at `η` is `germAt η u * germ c`. -/
theorem germAt_mul_of_forall_lt (u c : A) (η : Γ) (hu : ∀ β, η < β → sys.germAt β u = 0) :
    sys.germAt η (u * c) = sys.germAt η u * sys.germ c := by
  rw [sys.convolution, finsum_eq_single (fun β => sys.germAt β u * sys.germAt (η - β) c) η]
  · rw [sub_self, sys.germAt_zero]
  · intro β hβ
    rcases lt_or_gt_of_ne hβ with hlt | hgt
    · rw [sys.germAt_of_pos c (η - β) (by simpa using sub_pos.mpr hlt), mul_zero]
    · rw [hu β hgt, zero_mul]

/-- If `u` has no germs above `β`, neither does `u * c`. -/
theorem germAt_mul_eq_zero (u c : A) (β : Γ) (hu : ∀ y, β < y → sys.germAt y u = 0)
    (ξ : Γ) (hξ : β < ξ) : sys.germAt ξ (u * c) = 0 := by
  have hz : ∀ y, sys.germAt y u * sys.germAt (ξ - y) c = 0 := by
    intro y
    by_cases hy : sys.germAt y u = 0
    · rw [hy, zero_mul]
    · have hyβ : y ≤ β := le_of_not_gt fun h => hy (hu y h)
      rw [sys.germAt_of_pos c (ξ - y) (by simpa using sub_pos.mpr (lt_of_le_of_lt hyβ hξ)),
        mul_zero]
  rw [sys.convolution]; simp only [hz, finsum_zero]

/-- The monomial `t^γ` for an exponent `γ ≤ 0`. -/
noncomputable def monomial (γ : Γ) (hγ : γ ≤ 0) : A := Classical.choose (sys.exists_monomial γ hγ)

theorem germAt_monomial_mul (γ : Γ) (hγ : γ ≤ 0) (b : A) (ξ : Γ) :
    sys.germAt ξ (sys.monomial γ hγ * b) = sys.germAt (ξ - γ) b :=
  Classical.choose_spec (sys.exists_monomial γ hγ) b ξ

theorem monomial_mem_seriesWithConstantGerms (γ : Γ) (hγ : γ ≤ 0) :
    sys.monomial γ hγ ∈ sys.seriesWithConstantGerms := by
  intro ξ
  have h := sys.germAt_monomial_mul γ hγ 1 ξ
  rw [mul_one] at h
  rw [h]
  exact (sys.seriesWithGermsIn ⊥).one_mem (ξ - γ)

/-- A germ that vanishes at `η ≤ 0` vanishes on a left neighbourhood `(ε, η]` of `η`. -/
theorem exists_germAt_eq_zero_of_germAt_eq_zero (b : A) (η : Γ) (hη : η ≤ 0)
    (hb : sys.germAt η b = 0) : ∃ ε < η, ∀ ζ, ε < ζ → ζ ≤ η → sys.germAt ζ b = 0 := by
  obtain ⟨b', hb'⟩ := sys.exists_translatedTruncation b η hη
  have hgerm : sys.germ b' = 0 := by
    have h0 := hb' 0 le_rfl
    rw [add_zero] at h0
    rw [← sys.germAt_zero b', h0]; exact hb
  obtain ⟨ε', hε', hvan⟩ :=
    sys.germAt_eventually_eq_zero b' ⟨0, by rw [map_zero]; exact hgerm.symm⟩
  refine ⟨η + ε', by simpa using add_lt_add_left hε' η, fun ζ hζlo hζhi => ?_⟩
  rcases eq_or_lt_of_le hζhi with rfl | hζlt
  · exact hb
  · have hε'lt : ε' < ζ - η := lt_sub_iff_add_lt.mpr (by rw [add_comm]; exact hζlo)
    have hb'val := hb' (ζ - η) (sub_nonpos.mpr hζlt.le)
    rw [add_sub_cancel] at hb'val
    rw [← hb'val]
    exact hvan (ζ - η) hε'lt (sub_neg.mpr hζlt)

/-! ### Truncation closure of an adjunction -/

/-- Given `η < b`, there is `β'` with `η ≤ β' < b` such that the germ support of `X` avoids the
open interval `(η - b, η - β')`. -/
theorem exists_germSupport_gap (X : A) (η b : Γ) (hb : η < b) :
    ∃ β', η ≤ β' ∧ β' < b ∧ ∀ z, sys.germAt z X ≠ 0 → η - b < z → η - β' ≤ z := by
  by_cases hne : ({ξ | sys.germAt ξ X ≠ 0} ∩ Set.Ioi (η - b)).Nonempty
  · have hWF : ({ξ | sys.germAt ξ X ≠ 0} ∩ Set.Ioi (η - b)).IsWF :=
      (sys.germSupport_isWF X).mono Set.inter_subset_left
    have hmem := hWF.min_mem hne
    refine ⟨η - hWF.min hne, ?_, ?_, fun z hz hzgt => ?_⟩
    · rw [sub_eq_add_neg]
      exact le_add_of_nonneg_right (neg_nonneg.mpr (sys.nonpos_of_germAt_ne_zero hmem.1))
    · have h := sub_lt_iff_lt_add.mp hmem.2
      rw [add_comm] at h
      exact sub_lt_iff_lt_add.mpr h
    · rw [sub_sub_cancel]; exact hWF.min_le hne ⟨hz, hzgt⟩
  · exact ⟨η, le_rfl, hb, fun z hz hzgt => absurd ⟨hz, hzgt⟩ fun h => hne ⟨z, h⟩⟩

/-- If the germ support of `v` lies in `(β', β]` and that of `X` avoids `(η - β, η - β')`, then
the truncation of `v * X` at `η` is `v` times the truncation of `X` at `η - β`. -/
theorem truncation_mul_of_gap (v X : A) (η β β' : Γ)
    (hv : ∀ y, sys.germAt y v ≠ 0 → β' < y ∧ y ≤ β)
    (hgap : ∀ z, sys.germAt z X ≠ 0 → η - β < z → η - β' ≤ z) :
    sys.truncation (v * X) η = v * sys.truncation X (η - β) := by
  refine sys.germAt_injective fun ξ => ?_
  rw [germAt_truncation, sys.convolution v (sys.truncation X (η - β)) ξ]
  split_ifs with hξ
  · rw [sys.convolution v X ξ]
    refine finsum_congr fun y => ?_
    simp only [germAt_truncation]
    by_cases hy : sys.germAt y v = 0
    · rw [hy, zero_mul, zero_mul]
    · obtain ⟨hy1, -⟩ := hv y hy
      by_cases hc : ξ - y ≤ η - β
      · rw [if_pos hc]
      · rw [if_neg hc, mul_zero]
        suffices hX0 : sys.germAt (ξ - y) X = 0 by rw [hX0, mul_zero]
        by_contra hX0
        have h1 : η - β' ≤ ξ - y := hgap (ξ - y) hX0 (lt_of_not_ge hc)
        have h2 : ξ - y < η - β' :=
          lt_of_lt_of_le (sub_lt_sub_left hy1 ξ) (sub_le_sub_right hξ β')
        exact absurd h1 (not_le.mpr h2)
  · have hz : ∀ y, sys.germAt y v * sys.germAt (ξ - y) (sys.truncation X (η - β)) = 0 := by
      intro y
      by_cases hy : sys.germAt y v = 0
      · rw [hy, zero_mul]
      · obtain ⟨-, hy2⟩ := hv y hy
        rw [germAt_truncation]
        by_cases hc : ξ - y ≤ η - β
        · exfalso
          exact hξ (by simpa [sub_add_cancel] using add_le_add hc hy2)
        · rw [if_neg hc, mul_zero]
    simp only [hz, finsum_zero]

/-- If all truncations of `w` and the truncations of `X` at negative exponents lie in
`E = K[R, X]`, then so do all truncations of `w * X`. -/
theorem truncation_mul_mem_adjoin (R : Subalgebra K A) (X : A)
    (hXlow : ∀ ζ : Γ, ζ < 0 → sys.truncation X ζ ∈ Algebra.adjoin K (insert X (R : Set A)))
    (w : A) (hw : ∀ η, sys.truncation w η ∈ Algebra.adjoin K (insert X (R : Set A))) (η : Γ) :
    sys.truncation (w * X) η ∈ Algebra.adjoin K (insert X (R : Set A)) := by
  set E := Algebra.adjoin K (insert X (R : Set A))
  have hXE : X ∈ E := Algebra.subset_adjoin (Set.mem_insert _ _)
  have key : ∀ β, sys.germAt β w ≠ 0 → sys.truncation (sys.truncation w β * X) η ∈ E := by
    intro β hβ0
    refine Set.WellFoundedOn.induction (sys.germSupport_isWF w)
      (P := fun c => sys.truncation (sys.truncation w c * X) η ∈ E) hβ0 ?_
    intro b _ IH
    by_cases hbη : b ≤ η
    · have hvanish : ∀ ξ, η < ξ → sys.germAt ξ (sys.truncation w b * X) = 0 :=
        fun ξ hξ => sys.germAt_mul_eq_zero _ X b
          (fun y hy => by rw [germAt_truncation, if_neg (not_le.mpr hy)]) ξ
          (lt_of_le_of_lt hbη hξ)
      rw [sys.truncation_eq_self _ η hvanish]
      exact E.mul_mem (hw b) hXE
    · have hbgt : η < b := lt_of_not_ge hbη
      obtain ⟨β', hβ'1, hβ'2, hgap⟩ := sys.exists_germSupport_gap X η b hbgt
      set band := sys.truncation w b - sys.truncation w β' with hband
      have hv : ∀ y, sys.germAt y band ≠ 0 → β' < y ∧ y ≤ b := by
        intro y hy
        rw [hband, map_sub, germAt_truncation, germAt_truncation] at hy
        refine ⟨lt_of_not_ge fun h => ?_, le_of_not_gt fun h => ?_⟩
        · rw [if_pos (h.trans hβ'2.le), if_pos h, sub_self] at hy
          exact hy rfl
        · rw [if_neg (not_le.mpr h), if_neg (not_le.mpr (hβ'2.trans h)), sub_zero] at hy
          exact hy rfl
      have hpart2 : sys.truncation (band * X) η ∈ E := by
        rw [sys.truncation_mul_of_gap band X η b β' hv hgap]
        exact E.mul_mem (E.sub_mem (hw b) (hw β')) (hXlow (η - b) (sub_neg.mpr hbgt))
      have hpart1 : sys.truncation (sys.truncation w β' * X) η ∈ E := by
        rcases sys.truncation_eq_zero_or_exists w β' with h0 | ⟨ζ, hζle, hζW, htreq⟩
        · rw [h0, zero_mul, truncation_zero]; exact zero_mem E
        · rw [htreq]; exact IH ζ hζW (lt_of_le_of_lt hζle hβ'2)
      have hdecomp : sys.truncation w b * X = sys.truncation w β' * X + band * X := by
        rw [hband]; ring
      rw [hdecomp, sys.truncation_add]
      exact E.add_mem hpart1 hpart2
  by_cases hw0 : w = 0
  · rw [hw0, zero_mul, truncation_zero]; exact zero_mem E
  · obtain ⟨βtop, hβtop, hwtop⟩ := sys.exists_truncation_eq_self hw0
    simpa [hwtop] using key βtop hβtop

omit [CharZero K] in
private theorem adjoin_insert_eq_restrictScalars (R : Subalgebra K A) (X : A) :
    Algebra.adjoin K (insert X (R : Set A)) =
      (Algebra.adjoin R ({X} : Set A)).restrictScalars K := by
  have hrange : (IsScalarTower.toAlgHom K R A).range = R := by
    rw [show IsScalarTower.toAlgHom K R A = R.val from AlgHom.ext fun _ => rfl, R.range_val]
  rw [Algebra.Subalgebra.restrictScalars_adjoin, hrange, Set.insert_eq, Algebra.adjoin_union,
    Algebra.adjoin_eq, sup_comm]

/-- Adjoining to a truncation-closed subalgebra `R` a series `X` whose truncations at negative
exponents lie in `R` gives a truncation-closed subalgebra. -/
@[blueprint "lem:truncation-closed-adjunction"
  (phase := "Polynomial presentations")
  (title := "Closure under truncation of a simple extension")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on a ring of series $A$
    (\ref{def:series-germ-axioms}).  Let $R\subseteq A$ be a $K$-subalgebra
    closed under truncation, and let $X\in A$ with $X_{|\zeta}\in R$ for every
    $\zeta<0$.  Then the $K$-subalgebra $R[X]$ is closed under truncation.
  -/)
  (proof := /--
    The argument uses the convolution formula (axiom (2) of
    \ref{def:germ-axioms}) and the axioms of \ref{def:series-germ-axioms}.
    Write $E=R[X]$.  It suffices to show that if all truncations of $w$ lie in
    $E$, then so do all truncations of $wX$; induction on $n$ then handles
    $aX^n$ with $a\in R$, and these span $E$.  Fix $\eta$, and show
    $(w_{|\beta}X)_{|\eta}\in E$ by well-founded induction on the exponents
    $\beta$ at which $w$ has a nonzero germ.  If $\beta\le\eta$, then
    $w_{|\beta}X$ has no germs above $\eta$ and equals its own truncation.  If
    $\beta>\eta$, well-foundedness gives $\beta'\in[\eta,\beta)$ such that $X$
    has no nonzero germ at exponents in $(\eta-\beta,\eta-\beta')$.  The series
    $v=w_{|\beta}-w_{|\beta'}$ has germs only in $(\beta',\beta]$, and the
    convolution formula gives $(vX)_{|\eta}=v\,X_{|\eta-\beta}\in E$ since
    $\eta-\beta<0$.  The remaining term $(w_{|\beta'}X)_{|\eta}$ is covered by
    the induction hypothesis, because $w_{|\beta'}=w_{|\zeta}$ for the greatest
    $\zeta\le\beta'$ at which $w$ has a nonzero germ.
  -/)]
theorem isTruncationClosed_adjoin_insert {R : Subalgebra K A} (hR : sys.IsTruncationClosed R)
    (X : A) (hXlow : ∀ ζ : Γ, ζ < 0 → sys.truncation X ζ ∈ R) :
    sys.IsTruncationClosed (Algebra.adjoin K (insert X (R : Set A))) := by
  set E := Algebra.adjoin K (insert X (R : Set A))
  have hRE : R ≤ E := fun x hx => Algebra.subset_adjoin (Set.mem_insert_of_mem _ hx)
  have hmono : ∀ a ∈ R, ∀ (n : ℕ) (η : Γ), sys.truncation (a * X ^ n) η ∈ E := by
    intro a ha n
    induction n with
    | zero => intro η; rw [pow_zero, mul_one]; exact hRE (hR a ha η)
    | succ n IH =>
      intro η
      rw [pow_succ, ← mul_assoc]
      exact sys.truncation_mul_mem_adjoin R X (fun ζ hζ => hRE (hXlow ζ hζ)) _ IH η
  have hpoly : ∀ p : Polynomial R, ∀ η, sys.truncation (Polynomial.aeval X p) η ∈ E := by
    intro p
    induction p using Polynomial.induction_on' with
    | add p q hp hq =>
      intro η; rw [map_add, sys.truncation_add]; exact E.add_mem (hp η) (hq η)
    | monomial n a =>
      intro η; rw [Polynomial.aeval_monomial]; exact hmono a a.2 n η
  intro b hb η
  have hb' : b ∈ Algebra.adjoin R ({X} : Set A) :=
    (Subalgebra.mem_restrictScalars K).mp (by rw [← adjoin_insert_eq_restrictScalars R X]; exact hb)
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hb'
  obtain ⟨p, rfl⟩ := hb'
  exact hpoly p η

/-! ### Transcendence over subalgebras of series -/

/-- If `germ X` is transcendental over `S`, then `X` is transcendental over every subalgebra `R₀`
over `seriesWithConstantGerms` whose elements have all their germs in `S`: the top germ of a
polynomial relation for `X` over `R₀` is a polynomial relation for `germ X` over `S`. -/
@[blueprint "lem:transcendence-of-series"
  (phase := "Polynomial presentations")
  (title := "Transcendence of a series with transcendental germ")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on a ring of series $A$
    (\ref{def:series-germ-axioms}).  Let $S\subseteq Q$ be a $K$-subalgebra,
    let $R_0\subseteq A$ be an $A_K$-subalgebra contained in $A_S$, and let
    $X\in A$ be such that $[X]$ is transcendental over $S$.  Then $X$ is
    transcendental over $R_0$.
  -/)
  (proof := /--
    Let $\sum_kc_kX^k=0$ with $c_k\in R_0$ not all zero, and let $\eta$ be the
    greatest exponent at which some $c_k$ has a nonzero germ; it exists by
    axiom (11) of \ref{def:series-germ-axioms}.  No $c_k$ has germs above
    $\eta$, so the convolution formula (axiom (2) of \ref{def:germ-axioms})
    gives $g_\eta(c_kX^k)=g_\eta(c_k)\,[X]^k$.  Hence
    $\sum_kg_\eta(c_k)\,[X]^k=0$ is a nontrivial polynomial relation for $[X]$
    over $S$.
  -/)]
theorem transcendental_of_transcendental_germ {S : Subalgebra K Q}
    {R₀ : Subalgebra sys.seriesWithConstantGerms A}
    (hsub : (R₀ : Set A) ⊆ sys.seriesWithGermsIn S) {X : A}
    (htr : Transcendental S (sys.germ X)) : Transcendental R₀ X := by
  classical
  rw [transcendental_iff]
  intro p hp
  by_contra hpne
  set d := p.natDegree
  have hcoeS : ∀ k (ξ : Γ), sys.germAt ξ ((p.coeff k : R₀) : A) ∈ S :=
    fun k ξ => (sys.mem_seriesWithGermsIn.mp (hsub (p.coeff k).2)) ξ
  set ηfun : ℕ → Γ := fun k =>
    if h : ((p.coeff k : R₀) : A) ≠ 0 then (sys.exists_max_germSupport h).choose else 0
  have hηspec : ∀ k (h : ((p.coeff k : R₀) : A) ≠ 0),
      sys.germAt (ηfun k) ((p.coeff k : R₀) : A) ≠ 0 ∧
      ∀ ξ, sys.germAt ξ ((p.coeff k : R₀) : A) ≠ 0 → ξ ≤ ηfun k := by
    intro k h
    have he : ηfun k = (sys.exists_max_germSupport h).choose := dif_pos h
    rw [he]; exact (sys.exists_max_germSupport h).choose_spec
  have hsne : p.support.Nonempty := Polynomial.support_nonempty.mpr hpne
  set η := p.support.sup' hsne ηfun with hηdef
  have hvanish : ∀ k, ∀ β, η < β → sys.germAt β ((p.coeff k : R₀) : A) = 0 := by
    intro k β hβ
    by_cases hk0 : ((p.coeff k : R₀) : A) = 0
    · rw [hk0, map_zero]
    · have hksupp : k ∈ p.support := by
        rw [Polynomial.mem_support_iff, Ne, ← Subalgebra.coe_eq_zero]; exact hk0
      by_contra hne
      exact absurd (((hηspec k hk0).2 β hne).trans (Finset.le_sup' ηfun hksupp))
        (not_le.mpr hβ)
  obtain ⟨k₀, hk₀supp, hk₀eq⟩ := Finset.exists_mem_eq_sup' hsne ηfun
  have hk₀ne : ((p.coeff k₀ : R₀) : A) ≠ 0 := by
    rw [Ne, Subalgebra.coe_eq_zero]; exact Polynomial.mem_support_iff.mp hk₀supp
  have hLη0 : sys.germAt η ((p.coeff k₀ : R₀) : A) ≠ 0 := by
    rw [hηdef, hk₀eq]; exact (hηspec k₀ hk₀ne).1
  have hzero : ∑ k ∈ Finset.range (d + 1),
      sys.germAt η ((p.coeff k : R₀) : A) * sys.germ X ^ k = 0 := by
    rw [← map_zero (sys.germAt η), ← hp, Polynomial.aeval_eq_sum_range, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Algebra.smul_def, show algebraMap R₀ A (p.coeff k) = ((p.coeff k : R₀) : A) from rfl,
      sys.germAt_mul_of_forall_lt _ _ η (hvanish k), map_pow]
  set q : Polynomial S := ∑ k ∈ Finset.range (d + 1),
    Polynomial.monomial k (⟨sys.germAt η ((p.coeff k : R₀) : A), hcoeS k η⟩ : S) with hqdef
  have hqae : Polynomial.aeval (sys.germ X) q = 0 := by
    rw [hqdef, map_sum, ← hzero]
    exact Finset.sum_congr rfl fun k _ => by rw [Polynomial.aeval_monomial]; rfl
  have hqne : q ≠ 0 := by
    intro hq0
    have hco : q.coeff k₀ = 0 := by rw [hq0, Polynomial.coeff_zero]
    rw [hqdef, Polynomial.finsetSum_coeff,
      Finset.sum_eq_single k₀
        (fun k _ hkne => by rw [Polynomial.coeff_monomial, if_neg hkne])
        (fun hns => absurd (Finset.mem_range.mpr
          (Nat.lt_succ_of_le (Polynomial.le_natDegree_of_mem_supp k₀ hk₀supp))) hns),
      Polynomial.coeff_monomial, if_pos rfl] at hco
    exact hLη0 (by simpa using (Subalgebra.coe_eq_zero (S := S)).mpr hco)
  exact hqne (transcendental_iff.mp htr q hqae)

/-- A truncation-closed subalgebra `R` with `seriesWithConstantGerms ≤ R`, such that every element
of `S` is the germ of an element of `R`, contains `seriesWithGermsIn S`. -/
@[blueprint "lem:generation"
  (phase := "Polynomial presentations")
  (title := "Generation by a subalgebra closed under truncation")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on a ring of series $A$
    (\ref{def:series-germ-axioms}).  Let $S\subseteq Q$ be a $K$-subalgebra,
    and let $R\subseteq A$ be a $K$-subalgebra that is closed under truncation,
    contains $A_K$, and contains for every $a\in S$ some $r$ with $[r]=a$.
    Then $A_S\subseteq R$.
  -/)
  (proof := /--
    Let $b\in A_S$.  Show $b_{|\eta}\in R$ by well-founded induction on the
    exponents $\eta$ at which $b$ has a nonzero germ.  Choose $r\in R$ with
    $[r]=g_\eta(b)$ and put $c=t^\eta r$ (axiom (10) of
    \ref{def:series-germ-axioms}); the monomial $t^\eta$ has constant germs,
    so $c\in R$, and $c$ has no germs above $\eta$.  The difference
    $d=b_{|\eta}-c$ has $g_\eta(d)=0$ and no germs above $\eta$; applying
    axioms (3) and (4) of \ref{def:germ-axioms} to it shows that its germs
    vanish on some $(\varepsilon,\eta]$, so $d=b_{|\varepsilon}-c_{|\varepsilon}$.  Here
    $c_{|\varepsilon}\in R$ by closure under truncation, and
    $b_{|\varepsilon}=b_{|\zeta}$ for the greatest $\zeta\le\varepsilon$ at
    which $b$ has a nonzero germ, which lies in $R$ by induction.  Finally
    $b=b_{|\eta}$ for the greatest $\eta$ at which $b$ has a nonzero germ.
  -/)]
theorem seriesWithGermsIn_le {S : Subalgebra K Q} {R : Subalgebra K A}
    (hR : sys.IsTruncationClosed R) (hBR : sys.seriesWithConstantGerms ≤ R)
    (hlift : ∀ a ∈ S, ∃ r ∈ R, sys.germ r = a) :
    sys.seriesWithGermsIn S ≤ R := by
  intro b hb
  have key : ∀ η, sys.germAt η b ≠ 0 → sys.truncation b η ∈ R := by
    intro η hη0
    refine Set.WellFoundedOn.induction (sys.germSupport_isWF b)
      (P := fun η => sys.truncation b η ∈ R) hη0 ?_
    intro η hηmem IH
    have hηle : η ≤ 0 := sys.nonpos_of_germAt_ne_zero hηmem
    obtain ⟨r, hrR, hrg⟩ := hlift (sys.germAt η b) (hb η)
    set c := sys.monomial η hηle * r with hc
    have hcR : c ∈ R := R.mul_mem (hBR (sys.monomial_mem_seriesWithConstantGerms η hηle)) hrR
    have hcgerm : ∀ ξ, sys.germAt ξ c = sys.germAt (ξ - η) r :=
      fun ξ => sys.germAt_monomial_mul η hηle r ξ
    have hcabove : ∀ ξ, η < ξ → sys.germAt ξ c = 0 := fun ξ hξ => by
      rw [hcgerm]; exact sys.germAt_of_pos r (ξ - η) (by simpa using sub_pos.mpr hξ)
    set d := sys.truncation b η - c with hd
    have hdη : sys.germAt η d = 0 := by
      rw [hd, map_sub, germAt_truncation, if_pos le_rfl, hcgerm, sub_self, sys.germAt_zero, hrg,
        sub_self]
    have hdabove : ∀ ξ, η < ξ → sys.germAt ξ d = 0 := fun ξ hξ => by
      rw [hd, map_sub, germAt_truncation, if_neg (not_le.mpr hξ), hcabove ξ hξ, sub_zero]
    obtain ⟨ε, hεη, hvan⟩ := sys.exists_germAt_eq_zero_of_germAt_eq_zero d η hηle hdη
    have hdeq : d = sys.truncation b ε - sys.truncation c ε := by
      rw [← sys.truncation_eq_self d ε fun ζ hζ => (le_or_gt ζ η).elim (hvan ζ hζ) (hdabove ζ),
        hd, sys.truncation_sub, sys.truncation_truncation, min_eq_right hεη.le]
    have htrbε : sys.truncation b ε ∈ R := by
      rcases sys.truncation_eq_zero_or_exists b ε with h0 | ⟨ζ, hζle, hζW, htreq⟩
      · rw [h0]; exact zero_mem R
      · rw [htreq]; exact IH ζ hζW (lt_of_le_of_lt hζle hεη)
    have hdR : d ∈ R := by rw [hdeq]; exact R.sub_mem htrbε (hR c hcR ε)
    rw [show sys.truncation b η = c + d by rw [hd]; ring]
    exact R.add_mem hcR hdR
  by_cases hb0 : b = 0
  · rw [hb0]; exact zero_mem R
  · obtain ⟨βtop, hβtop, hbtop⟩ := sys.exists_truncation_eq_self hb0
    rw [← hbtop]; exact key βtop hβtop

omit [CharZero K] in
private theorem restrictScalars_adjoin_eq (B : Subalgebra K A) (𝒳 : Set A) :
    (Algebra.adjoin B 𝒳).restrictScalars K = Algebra.adjoin K (↑B ∪ 𝒳) := by
  have hrange : (IsScalarTower.toAlgHom K B A).range = B := by
    rw [show IsScalarTower.toAlgHom K B A = B.val from AlgHom.ext fun _ => rfl, B.range_val]
  rw [Algebra.Subalgebra.restrictScalars_adjoin, hrange, Algebra.adjoin_union, Algebra.adjoin_eq]

omit [CharZero K] in
private theorem adjoin_eq_top_iff (B : Subalgebra K A) (𝒳 : Set A) :
    Algebra.adjoin B 𝒳 = ⊤ ↔ Algebra.adjoin K (↑B ∪ 𝒳) = ⊤ := by
  rw [← restrictScalars_adjoin_eq B 𝒳, ← Subalgebra.restrictScalars_top (R := K) (S := B)]
  exact (Subalgebra.restrictScalars_injective K).eq_iff.symm

/-! ### The polynomial presentation -/

/-- **Polynomial presentation of the ring of series.** The ring of series `A` is a polynomial ring
over its subalgebra `seriesWithConstantGerms` of series all of whose germs are constants: it has an
algebraically independent generating set over that subalgebra. -/
@[blueprint "thm:series-ring-generators"
  (phase := "Polynomial presentations")
  (title := "Algebraically independent generators of the ring of series")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on a ring of series $A$
    (\ref{def:series-germ-axioms}).  There is a set $\mathcal X\subseteq A$,
    algebraically independent over $A_K$, such that $A_K[\mathcal X]=A$.
  -/)
  (proof := /--
    By Zorn's lemma choose a maximal set $\mathcal X$, algebraically independent
    over $A_K$, such that $R=A_K[\mathcal X]$ is closed under truncation and
    $R\subseteq A_S$ for $S=K[\{[X]:X\in\mathcal X\}]$.  By
    \ref{lem:generation}, $R=A_S$.  Suppose $S\ne Q$.  As in the proof of
    \ref{thm:germ-ring-generators}, a germ outside $S$ of minimal rank is $[X]$
    for a series $X$ whose germs at negative exponents lie in $S$.  By
    \ref{thm:germ-ring-generators} $Q$ is a polynomial ring over $K$, so $S$
    is an integral domain, and the transcendence lemma makes $[X]$
    transcendental over $S$.  By \ref{lem:transcendence-of-series}, $X$ is
    transcendental over $R$.  For $\zeta<0$ all germs of $X_{|\zeta}$ lie in $S$,
    so $X_{|\zeta}\in A_S=R$, and \ref{lem:truncation-closed-adjunction} shows
    that $R[X]$ is closed under truncation.  Thus $\mathcal X\cup\{X\}$
    contradicts maximality.  Hence $S=Q$ and $R=A_Q=A$.
  -/)]
theorem exists_algebraicIndependent_series_generators :
    ∃ 𝒳 : Set A, AlgebraicIndependent sys.seriesWithConstantGerms ((↑) : 𝒳 → A) ∧
      Algebra.adjoin sys.seriesWithConstantGerms 𝒳 = ⊤ := by
  set B := sys.seriesWithConstantGerms
  have hBsub : ∀ 𝒳 : Set A, B ≤ Algebra.adjoin K (↑B ∪ 𝒳) :=
    fun 𝒳 => (Algebra.adjoin_eq B).ge.trans (Algebra.adjoin_mono Set.subset_union_left)
  have hlift : ∀ 𝒳 : Set A, ∀ a ∈ Algebra.adjoin K (sys.germ '' 𝒳),
      ∃ r ∈ Algebra.adjoin K (↑B ∪ 𝒳), sys.germ r = a := by
    intro 𝒳 a ha
    have hle : Algebra.adjoin K (sys.germ '' 𝒳) ≤ (Algebra.adjoin K (↑B ∪ 𝒳)).map sys.germ := by
      refine Algebra.adjoin_le ?_
      rintro _ ⟨x, hx, rfl⟩
      exact ⟨x, Algebra.subset_adjoin (Set.mem_union_right _ hx), rfl⟩
    exact hle ha
  have hgen : ∀ 𝒳 : Set A, sys.IsTruncationClosed (Algebra.adjoin K (↑B ∪ 𝒳)) →
      sys.seriesWithGermsIn (Algebra.adjoin K (sys.germ '' 𝒳)) ≤ Algebra.adjoin K (↑B ∪ 𝒳) :=
    fun 𝒳 hTC => sys.seriesWithGermsIn_le hTC (hBsub 𝒳) (hlift 𝒳)
  set P : Set (Set A) := {𝒳 | AlgebraicIndependent B ((↑) : 𝒳 → A) ∧
    sys.IsTruncationClosed (Algebra.adjoin K (↑B ∪ 𝒳)) ∧
    Algebra.adjoin K (↑B ∪ 𝒳) ≤ sys.seriesWithGermsIn (Algebra.adjoin K (sys.germ '' 𝒳))}
    with hPdef
  haveI : Nontrivial A := ⟨0, 1, fun h => zero_ne_one (α := Q) (by simpa using congrArg sys.germ h)⟩
  have hEmpty : (∅ : Set A) ∈ P := by
    refine ⟨(algebraicIndependent_empty_iff B A).mpr fun a b h => Subtype.ext h, ?_, ?_⟩
    · rw [Set.union_empty, Algebra.adjoin_eq]; exact sys.isTruncationClosed_seriesWithGermsIn ⊥
    · rw [Set.union_empty, Algebra.adjoin_eq, Set.image_empty, Algebra.adjoin_empty]
      exact le_rfl
  have hChain : ∀ c ⊆ P, IsChain (· ⊆ ·) c → c.Nonempty → ∃ ub ∈ P, ∀ s ∈ c, s ⊆ ub := by
    intro c hc chainc hcn
    haveI : Nonempty c := hcn.to_subtype
    have hdir : Directed (· ≤ ·) fun s : c => Algebra.adjoin K (↑B ∪ (s : Set A)) := by
      rintro ⟨s, hs⟩ ⟨t, ht⟩
      rcases chainc.total hs ht with hst | hts
      · exact ⟨⟨t, ht⟩, Algebra.adjoin_mono (Set.union_subset_union_right _ hst), le_rfl⟩
      · exact ⟨⟨s, hs⟩, le_rfl, Algebra.adjoin_mono (Set.union_subset_union_right _ hts)⟩
    refine ⟨⋃₀ c, ⟨?_, ?_, ?_⟩, fun s hs => Set.subset_sUnion_of_mem hs⟩
    · exact algebraicIndependent_sUnion_of_directed hcn chainc.directedOn fun s hs => (hc hs).1
    · intro b hb η
      have hcoe : (Algebra.adjoin K (↑B ∪ ⋃₀ c) : Set A) =
          ⋃ s : c, (Algebra.adjoin K (↑B ∪ (s : Set A)) : Set A) := by
        rw [Set.sUnion_eq_iUnion, Set.union_iUnion, Algebra.adjoin_iUnion]
        exact Subalgebra.coe_iSup_of_directed hdir
      have hb' : b ∈ (Algebra.adjoin K (↑B ∪ ⋃₀ c) : Set A) := hb
      rw [hcoe, Set.mem_iUnion] at hb'
      obtain ⟨s, hbs⟩ := hb'
      exact Algebra.adjoin_mono (Set.union_subset_union_right _ (Set.subset_sUnion_of_mem s.2))
        ((hc s.2).2.1 b hbs η)
    · refine Algebra.adjoin_le fun y hy => ?_
      rcases hy with hyB | ⟨s, hsc, hys⟩
      · exact sys.seriesWithConstantGerms_le _ hyB
      · intro ξ
        exact Algebra.adjoin_mono (Set.image_mono (Set.subset_sUnion_of_mem hsc))
          ((hc hsc).2.2 (Algebra.subset_adjoin (Set.mem_union_right _ hys)) ξ)
  obtain ⟨𝒳, -, h𝒳max⟩ := zorn_subset_nonempty P hChain ∅ hEmpty
  obtain ⟨hAI, hTC, hle⟩ := h𝒳max.1
  refine ⟨𝒳, hAI, ?_⟩
  have hReq : Algebra.adjoin K (↑B ∪ 𝒳) = sys.seriesWithGermsIn (Algebra.adjoin K (sys.germ '' 𝒳))
    := le_antisymm hle (hgen 𝒳 hTC)
  have hStop : Algebra.adjoin K (sys.germ '' 𝒳) = ⊤ := by
    set S := Algebra.adjoin K (sys.germ '' 𝒳)
    by_contra hSne
    have hSstab : sys.HasRepresentativesWithGermsIn S := by
      intro a ha
      obtain ⟨r, hr, hrg⟩ := hlift 𝒳 a ha
      exact ⟨r, hrg, hle hr⟩
    obtain ⟨g₀, hg₀⟩ : ∃ g : Q, g ∉ S := by
      by_contra h
      exact hSne (Algebra.eq_top_iff.mpr fun z => not_not.mp fun hz => h ⟨z, hz⟩)
    have hwf : WellFounded fun a b : Q => sys.rank a < sys.rank b :=
      InvImage.wf sys.rank Ordinal.lt_wf
    obtain ⟨x₀, hxnotS, hxmin⟩ := hwf.has_min {g : Q | g ∉ S} ⟨g₀, hg₀⟩
    have hmin : ∀ y : Q, sys.rank y < sys.rank x₀ → y ∈ S := fun y hy => by
      by_contra hyS; exact hxmin y hyS hy
    have hxnc : x₀ ∉ Set.range (algebraMap K Q) := by
      rintro ⟨k, rfl⟩; exact hxnotS (Subalgebra.algebraMap_mem S k)
    obtain ⟨X₀, hX₀⟩ := sys.germ_surjective x₀
    obtain ⟨ε, hε, hdrop⟩ := sys.rank_germAt_lt X₀ (by rw [hX₀]; exact hxnc)
    obtain ⟨X, hXg, hXeq, hXvan⟩ := sys.exists_cutoff X₀ ε hε
    have hXgerm : ∀ ξ < 0, sys.germAt ξ X ∈ S := by
      intro ξ hξ
      rcases le_or_gt ξ ε with hξε | hεξ
      · rw [hXvan ξ hξε]; exact zero_mem S
      · rw [hXeq ξ hεξ]
        exact hmin _ (by simpa [hX₀] using hdrop ξ hεξ hξ)
    have hxX : sys.germ X ∉ S := by rw [hXg, hX₀]; exact hxnotS
    haveI : IsDomain Q := sys.isDomain
    obtain ⟨htrans, -⟩ := sys.transcendental_germ S hSstab X hXgerm hxX
    have hXnotmem : X ∉ 𝒳 := fun hXmem => hxX (Algebra.subset_adjoin ⟨X, hXmem, rfl⟩)
    have hsub : (Algebra.adjoin B 𝒳 : Set A) ⊆ sys.seriesWithGermsIn S := by
      rw [← Subalgebra.coe_restrictScalars K, restrictScalars_adjoin_eq]; exact hle
    have htr2 : Transcendental (Algebra.adjoin B 𝒳) X :=
      sys.transcendental_of_transcendental_germ hsub htrans
    have hXlow : ∀ ζ : Γ, ζ < 0 → sys.truncation X ζ ∈ Algebra.adjoin K (↑B ∪ 𝒳) := by
      intro ζ hζ
      rw [hReq]
      intro ξ
      rw [germAt_truncation]
      split_ifs with h
      · exact hXgerm ξ (lt_of_le_of_lt h hζ)
      · exact zero_mem S
    have hadjeq : Algebra.adjoin K (↑B ∪ insert X 𝒳) =
        Algebra.adjoin K (insert X (Algebra.adjoin K (↑B ∪ 𝒳) : Set A)) := by
      apply le_antisymm
      · refine Algebra.adjoin_le fun y hy => ?_
        rcases hy with hyB | rfl | hy𝒳
        · exact Algebra.subset_adjoin (Set.mem_insert_of_mem _
            (Algebra.subset_adjoin (Set.mem_union_left _ hyB)))
        · exact Algebra.subset_adjoin (Set.mem_insert _ _)
        · exact Algebra.subset_adjoin (Set.mem_insert_of_mem _
            (Algebra.subset_adjoin (Set.mem_union_right _ hy𝒳)))
      · refine Algebra.adjoin_le fun y hy => ?_
        rcases hy with rfl | hyR
        · exact Algebra.subset_adjoin (Set.mem_union_right _ (Set.mem_insert _ _))
        · exact Algebra.adjoin_mono
            (Set.union_subset_union_right _ (Set.subset_insert X 𝒳)) hyR
    have hSS' : S ≤ Algebra.adjoin K (sys.germ '' insert X 𝒳) :=
      Algebra.adjoin_mono (Set.image_mono (Set.subset_insert X 𝒳))
    have hle' : Algebra.adjoin K (↑B ∪ insert X 𝒳) ≤
        sys.seriesWithGermsIn (Algebra.adjoin K (sys.germ '' insert X 𝒳)) := by
      refine Algebra.adjoin_le fun y hy => ?_
      rcases hy with hyB | rfl | hy𝒳
      · exact sys.seriesWithConstantGerms_le _ hyB
      · intro ξ
        rcases lt_trichotomy ξ 0 with hξ | rfl | hξ
        · exact hSS' (hXgerm ξ hξ)
        · rw [sys.germAt_zero]; exact Algebra.subset_adjoin ⟨y, Set.mem_insert _ _, rfl⟩
        · rw [sys.germAt_of_pos y ξ hξ]; exact zero_mem _
      · exact fun ξ => hSS' (hle (Algebra.subset_adjoin (Set.mem_union_right _ hy𝒳)) ξ)
    have hinsertP : insert X 𝒳 ∈ P := by
      refine ⟨?_, by rw [hadjeq]; exact sys.isTruncationClosed_adjoin_insert hTC X hXlow, hle'⟩
      exact AlgebraicIndepOn.insert (R := B) (x := (id : A → A)) (s := 𝒳) (i := X) hAI
        (by rw [Set.image_id]; exact htr2)
    exact hXnotmem (h𝒳max.2 hinsertP (Set.subset_insert X 𝒳) (Set.mem_insert X 𝒳))
  rw [adjoin_eq_top_iff, hReq, hStop, seriesWithGermsIn_top]

/-- The ring of series `A` is isomorphic to a polynomial ring over `seriesWithConstantGerms`. -/
theorem exists_mvPolynomial_algEquiv {A : Type u} [CommRing A] [Algebra K A]
    (sys : SeriesTruncationGerms K Γ A Q) :
    ∃ ι : Type u, Nonempty
      (MvPolynomial ι sys.seriesWithConstantGerms ≃ₐ[sys.seriesWithConstantGerms] A) := by
  obtain ⟨𝒳, hind, htop⟩ := sys.exists_algebraicIndependent_series_generators
  exact ⟨𝒳, ⟨hind.mvPolynomialAlgEquivOfAdjoinEqTop htop⟩⟩

end SeriesTruncationGerms

