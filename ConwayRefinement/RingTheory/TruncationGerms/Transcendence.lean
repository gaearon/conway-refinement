/-!
# Germs of translated truncations: transcendence and the ring of germs

From the axioms of `TruncationGerms`, the ring of germs `Q` is a polynomial ring over `K`; in
particular it is an integral domain (`isDomain`), although this is not assumed.

For a subalgebra `S` represented by series with all germs in `S`, suppose the germs of `X` at
negative exponents lie in `S`. A relation of positive degree on its germ yields one of the same
degree with leading coefficient one. Indeed, the convolution formula gives relations at all
exponents close to zero, and the first nonzero germ of the leading coefficient above the cutoff
is a scalar. For a monic relation of least degree, the next coefficient then shows that a nonzero
integer multiple of the germ of `X` belongs to `S`. Thus in characteristic zero a germ outside `S`
is transcendental.

A Zorn argument on algebraically independent sets (`exists_algebraicIndependent_adjoin_eq_top`)
presents an algebra as a polynomial ring once every proper subalgebra of the chosen kind, which is
an integral domain because it is a polynomial ring, admits a transcendental element whose
adjunction stays of that kind. With the transcendence lemma as this step, the ring of germs is a
polynomial ring (`exists_algebraicIndependent_generators`, `exists_mvPolynomial_algEquiv`).
-/

universe u w

public section

/-- An algebraically independent generating set presents an algebra as a polynomial ring. -/
noncomputable def AlgebraicIndependent.mvPolynomialAlgEquivOfAdjoinEqTop {R B : Type*} [CommRing R]
    [CommRing B] [Algebra R B] {T : Set B} (hind : AlgebraicIndependent R ((↑) : T → B))
    (htop : Algebra.adjoin R T = ⊤) : MvPolynomial T R ≃ₐ[R] B :=
  have hr : Algebra.adjoin R (Set.range ((↑) : T → B)) = ⊤ := by
    rw [Subtype.range_coe_subtype, Set.setOf_mem_eq]; exact htop
  hind.aevalEquiv.trans ((Subalgebra.equivOfEq _ _ hr).trans Subalgebra.topEquiv)

/-- The subalgebra generated by an algebraically independent set over an integral domain is an
integral domain: it is isomorphic to a polynomial ring. -/
theorem AlgebraicIndependent.isDomain_adjoin {R B : Type*} [CommRing R] [IsDomain R]
    [CommRing B] [Algebra R B] {T : Set B} (hind : AlgebraicIndependent R ((↑) : T → B)) :
    IsDomain (Algebra.adjoin R T) :=
  have hr : Algebra.adjoin R (Set.range ((↑) : T → B)) = Algebra.adjoin R T := by
    rw [Subtype.range_coe_subtype, Set.setOf_mem_eq]
  (hind.aevalEquiv.trans (Subalgebra.equivOfEq _ _ hr)).symm.toMulEquiv.isDomain _

/-- A subalgebra has algebraically independent generators if every proper intermediate
polynomial algebra with property `P` admits a transcendental adjunction inside the subalgebra
that preserves `P`, and `P` holds for the scalars and passes to unions of chains. -/
theorem exists_algebraicIndependent_adjoin_eq {K Q : Type*} [Field K] [CommRing Q]
    [Nontrivial Q] [Algebra K Q] (D : Subalgebra K Q) (P : Subalgebra K Q → Prop)
    (hbot : P ⊥)
    (hchain : ∀ c : Set (Set Q), c.Nonempty → IsChain (· ⊆ ·) c →
      (∀ T ∈ c, P (Algebra.adjoin K T)) → P (Algebra.adjoin K (⋃₀ c)))
    (hstep : ∀ S : Subalgebra K Q, IsDomain S → P S → S < D →
      ∃ x ∈ D, Transcendental S x ∧ P (Algebra.adjoin K (insert x (S : Set Q)))) :
    ∃ T : Set Q, AlgebraicIndependent K ((↑) : T → Q) ∧ Algebra.adjoin K T = D := by
  set 𝒞 := {T : Set Q | AlgebraicIndependent K ((↑) : T → Q) ∧ P (Algebra.adjoin K T) ∧ T ⊆ D}
  have hEmpty : (∅ : Set Q) ∈ 𝒞 :=
    ⟨algebraicIndependent_empty_type, by rwa [Algebra.adjoin_empty], Set.empty_subset _⟩
  have H : ∀ c ⊆ 𝒞, IsChain (· ⊆ ·) c → c.Nonempty → ∃ ub ∈ 𝒞, ∀ s ∈ c, s ⊆ ub :=
    fun c hc chainc hcn => ⟨⋃₀ c,
      ⟨algebraicIndependent_sUnion_of_directed hcn chainc.directedOn fun s hs => (hc hs).1,
        hchain c hcn chainc (fun s hs => (hc hs).2.1),
        Set.sUnion_subset fun s hs => (hc hs).2.2⟩, fun s hs => Set.subset_sUnion_of_mem hs⟩
  obtain ⟨T, -, hTmax⟩ := zorn_subset_nonempty 𝒞 H ∅ hEmpty
  obtain ⟨hTind, hTP, hTD⟩ := hTmax.1
  refine ⟨T, hTind, ?_⟩
  by_contra hne
  haveI := hTind.isDomain_adjoin
  obtain ⟨x, hxD, htrans, hxP⟩ := hstep _ inferInstance hTP
    (lt_of_le_of_ne (Algebra.adjoin_le hTD) hne)
  have hind' : AlgebraicIndependent K ((↑) : ↥(insert x T) → Q) := by
    have := AlgebraicIndepOn.insert (R := K) (x := (id : Q → Q)) (s := T) (i := x) hTind
      (by rw [Set.image_id]; exact htrans)
    exact this
  have hTeq : Algebra.adjoin K (insert x T) =
      Algebra.adjoin K (insert x (Algebra.adjoin K T : Set Q)) := by
    apply le_antisymm
    · exact Algebra.adjoin_mono (Set.insert_subset_insert Algebra.subset_adjoin)
    · apply Algebra.adjoin_le
      rw [Set.insert_subset_iff]
      exact ⟨Algebra.subset_adjoin (Set.mem_insert _ _),
        fun a ha => Algebra.adjoin_mono (Set.subset_insert x T) ha⟩
  have hsub : insert x T ⊆ T :=
    hTmax.2 ⟨hind', by rwa [hTeq], Set.insert_subset hxD hTD⟩ (Set.subset_insert _ _)
  exact htrans (isAlgebraic_algebraMap
    (⟨x, Algebra.subset_adjoin (hsub (Set.mem_insert _ _))⟩ : Algebra.adjoin K T))

/-- The polynomial presentation criterion for the full algebra. -/
theorem exists_algebraicIndependent_adjoin_eq_top {K Q : Type*} [Field K] [CommRing Q]
    [Nontrivial Q] [Algebra K Q] (P : Subalgebra K Q → Prop) (hbot : P ⊥)
    (hchain : ∀ c : Set (Set Q), c.Nonempty → IsChain (· ⊆ ·) c →
      (∀ T ∈ c, P (Algebra.adjoin K T)) → P (Algebra.adjoin K (⋃₀ c)))
    (hstep : ∀ S : Subalgebra K Q, IsDomain S → P S → S ≠ ⊤ →
      ∃ x, Transcendental S x ∧ P (Algebra.adjoin K (insert x (S : Set Q)))) :
    ∃ T : Set Q, AlgebraicIndependent K ((↑) : T → Q) ∧ Algebra.adjoin K T = ⊤ :=
  exists_algebraicIndependent_adjoin_eq ⊤ P hbot hchain fun S hdom hS hlt ↦ by
    obtain ⟨x, hx, hP⟩ := hstep S hdom hS hlt.ne
    exact ⟨x, trivial, hx, hP⟩

namespace ConvolutionGerms

variable {K Γ A Q : Type*} [Field K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
  [CommRing A] [Algebra K A] [CommRing Q] [Nontrivial Q] [Algebra K Q]
  (sys : ConvolutionGerms K Γ A Q)

/-- Adjoining the germ of `X` to `S` preserves the existence of representatives with germs in the
subalgebra. -/
theorem hasRepresentativesWithGermsIn_adjoin (S : Subalgebra K Q)
    (hS : sys.HasRepresentativesWithGermsIn S) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) :
    sys.HasRepresentativesWithGermsIn (Algebra.adjoin K (insert (sys.germ X) (S : Set Q))) := by
  set x := sys.germ X with hxdef
  set Sx := Algebra.adjoin K (insert x (S : Set Q)) with hSxdef
  have hS_le : ∀ a ∈ S, a ∈ Sx := fun a ha =>
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ ha)
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem a h =>
    rcases Set.mem_insert_iff.mp h with rfl | h
    · -- a = x
      refine ⟨X, rfl, fun ξ => ?_⟩
      rcases lt_trichotomy ξ 0 with hξ | rfl | hξ
      · exact hS_le _ (hX ξ hξ)
      · rw [sys.germAt_zero X]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
      · rw [sys.germAt_of_pos X ξ hξ]; exact zero_mem Sx
    · -- a ∈ S
      obtain ⟨b, hb, hbs⟩ := hS a h
      exact ⟨b, hb, fun ξ => hS_le _ (hbs ξ)⟩
  | algebraMap r =>
    obtain ⟨b, hb, hbs⟩ := hS (algebraMap K Q r) (Subalgebra.algebraMap_mem S r)
    exact ⟨b, hb, fun ξ => hS_le _ (hbs ξ)⟩
  | add a a' _ _ Pa Pa' =>
    obtain ⟨b, hb, hbs⟩ := Pa
    obtain ⟨b', hb', hbs'⟩ := Pa'
    refine ⟨b + b', by rw [map_add, hb, hb'], fun ξ => ?_⟩
    rw [map_add]; exact Sx.add_mem (hbs ξ) (hbs' ξ)
  | mul a a' _ _ Pa Pa' =>
    obtain ⟨b, hb, hbs⟩ := Pa
    obtain ⟨b', hb', hbs'⟩ := Pa'
    refine ⟨b * b', by rw [map_mul, hb, hb'], fun ξ => ?_⟩
    rw [sys.convolution b b' ξ]
    exact sys.finsum_convolution_mem Sx b b' ξ hbs hbs'

end ConvolutionGerms

namespace TruncationGerms

variable {K Γ A Q : Type*} [Field K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
  [CommRing A] [Algebra K A] [CommRing Q] [Nontrivial Q] [Algebra K Q]
  (sys : TruncationGerms K Γ A Q)

open Polynomial
open scoped HahnSeries

omit [Nontrivial Q] in
private theorem coeff_mul_finsum (b c : HahnSeries Γ Q) (ξ : Γ) :
    (b * c).coeff ξ = ∑ᶠ β, b.coeff β * c.coeff (ξ - β) := by
  classical
  let F := Finset.addAntidiagonal b.isPWO_support c.isPWO_support ξ
  have hs : Function.support (fun β ↦ b.coeff β * c.coeff (ξ - β)) ⊆ ↑(F.image Prod.fst) := by
    intro β hβ
    refine Finset.mem_image.mpr ⟨(β, ξ - β), ?_, rfl⟩
    exact Finset.mem_addAntidiagonal.mpr
      ⟨left_ne_zero_of_mul hβ, right_ne_zero_of_mul hβ, by
        change β + (ξ - β) = ξ
        rw [add_comm, sub_add_cancel]⟩
  rw [finsum_eq_finsetSum_of_support_subset _ hs, HahnSeries.coeff_mul]
  have hsnd {p : Γ × Γ} (hp : p ∈ F) : p.2 = ξ - p.1 :=
    eq_sub_of_add_eq' (Finset.mem_addAntidiagonal.mp hp).2.2
  rw [Finset.sum_image (fun p hp q hq he ↦ Prod.ext he (by rw [hsnd hp, hsnd hq, he]))]
  exact Finset.sum_congr rfl fun p hp ↦ by rw [hsnd hp]

/-- The coefficient at each exponent is the germ there. Multiplicativity is convolution. -/
private noncomputable def germSeriesHom (sys : TruncationGerms K Γ A Q) : A →+* Q⟦Γ⟧ where
  toFun b := ⟨fun ξ ↦ sys.germAt ξ b, (sys.germSupport_isWF b).isPWO⟩
  map_zero' := HahnSeries.ext (funext fun _ ↦ map_zero _)
  map_add' a b := HahnSeries.ext (funext fun _ ↦ map_add _ _ _)
  map_one' := by
    ext ξ
    change sys.germAt ξ 1 = _
    rw [HahnSeries.coeff_one]
    split_ifs with h
    · rw [h, sys.germAt_zero, map_one]
    · rw [show (1 : A) = algebraMap K A 1 by rw [map_one], sys.germAt_algebraMap _ _ h]
  map_mul' b c := by
    ext ξ
    rw [coeff_mul_finsum]
    exact sys.convolution b c ξ

private noncomputable def coefficientsIn (S : Subalgebra K Q) : Subring Q⟦Γ⟧ where
  carrier := {f | ∀ ξ, f.coeff ξ ∈ S}
  zero_mem' := fun _ ↦ S.zero_mem
  one_mem' ξ := by rw [HahnSeries.coeff_one]; split <;> simp
  add_mem' hb hc ξ := S.add_mem (hb ξ) (hc ξ)
  neg_mem' hb ξ := S.neg_mem (hb ξ)
  mul_mem' {b c} hb hc ξ := by
    rw [HahnSeries.coeff_mul]
    exact S.sum_mem fun p _ ↦ S.mul_mem (hb p.1) (hc p.2)

/-- The coefficient at each exponent of the binomial expansion of `L(B) (Y + U)^k`. -/
private theorem binomial_expansion (S : Subalgebra K Q) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) (B : A) (hB : ∀ ξ, sys.germAt ξ B ∈ S)
    (k : ℕ) (ξ : Γ) : ∃ q : Polynomial ↥S,
      q.natDegree ≤ k ∧ aeval (sys.germ X) q = sys.germAt ξ (B * X ^ k) ∧
      (q.coeff k : Q) = sys.germAt ξ B ∧ (1 ≤ k → (q.coeff (k - 1) : Q) =
        k • (sys.germAt ξ (B * X) - sys.germAt ξ B * sys.germ X)) := by
  classical
  let L := sys.germSeriesHom
  let x := sys.germ X
  let U := L X - HahnSeries.C x
  let T := coefficientsIn (Γ := Γ) S
  have hU : U ∈ T := by
    intro γ
    change sys.germAt γ X - (HahnSeries.single 0 x).coeff γ ∈ S
    rcases lt_trichotomy γ 0 with h | rfl | h
    · simpa [HahnSeries.coeff_single_of_ne h.ne] using hX γ h
    · simp [HahnSeries.coeff_single_same, sys.germAt_zero, x]
    · simp [HahnSeries.coeff_single_of_ne h.ne', sys.germAt_of_pos X _ h]
  have hcoeff (j : ℕ) : ((L B * U ^ (k - j)).coeff ξ) ∈ S :=
    (show ∀ γ, (L B * U ^ (k - j)).coeff γ ∈ S from
      T.mul_mem (show L B ∈ T from hB) (T.pow_mem hU (k - j))) ξ
  let a (j : ℕ) : S := (k.choose j) • ⟨_, hcoeff j⟩
  let q := ∑ j ∈ Finset.range (k + 1), Polynomial.monomial j (a j)
  have hq (j : ℕ) (hj : j ≤ k) : q.coeff j = a j := by
    simp [q, finsetSum_coeff, coeff_monomial, Nat.lt_succ_of_le hj]
  refine ⟨q, natDegree_sum_le_of_forall_le _ _ (fun j hj ↦
    (natDegree_monomial_le _).trans (Nat.le_of_lt_succ (Finset.mem_range.mp hj))), ?_, ?_, ?_⟩
  · change aeval x q = (L (B * X ^ k)).coeff ξ
    have he : L X = HahnSeries.C x + U := by simp [U]
    rw [map_mul, map_pow, he, add_pow, Finset.mul_sum, HahnSeries.coeff_sum]
    change aeval x (∑ j ∈ _, _) = _
    rw [map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [show L B * (HahnSeries.C x ^ j * U ^ (k - j) * ↑(k.choose j)) =
       (k.choose j) • ((L B * U ^ (k - j)) * HahnSeries.C (x ^ j)) by
      rw [map_pow, nsmul_eq_mul]; ring]
    rw [aeval_monomial, HahnSeries.coeff_nsmul, Pi.smul_apply, HahnSeries.C_apply,
      HahnSeries.coeff_mul_single_zero]
    change ((k.choose j) • (L B * U ^ (k - j)).coeff ξ) * x ^ j = _
    simp only [nsmul_eq_mul, mul_assoc]
  · rw [hq k le_rfl]
    simp [a, L, germSeriesHom]
  · intro hk
    rw [hq (k - 1) (Nat.sub_le ..)]
    rcases k with _ | n
    · omega
    · change ((n + 1).choose (n + 1 - 1)) • (L B * U ^ (n + 1 - (n + 1 - 1))).coeff ξ = _
      simp only [Nat.add_sub_cancel, Nat.add_sub_cancel_left, Nat.choose_succ_self_right, pow_one]
      congr 1
      change (L B * (L X - HahnSeries.C x)).coeff ξ = (L (B * X)).coeff ξ - _
      rw [mul_sub, map_mul, HahnSeries.coeff_sub, HahnSeries.C_apply,
        HahnSeries.coeff_mul_single_zero]
      rfl

private theorem relations_near_zero (S : Subalgebra K Q) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) {n : ℕ} (p : Polynomial ↥S)
    (hd : p.natDegree ≤ n + 1) (hp : aeval (sys.germ X) p = 0)
    (B : ℕ → A) (hB : ∀ i, sys.germ (B i) = ↑(p.coeff i))
    (hs : ∀ i ξ, sys.germAt ξ (B i) ∈ S) :
    ∃ ε < (0 : Γ), ∀ ξ, ε < ξ → ξ ≤ 0 → ∃ q : Polynomial ↥S,
      q.natDegree ≤ n + 1 ∧ aeval (sys.germ X) q = 0 ∧
      (q.coeff (n + 1) : Q) = sys.germAt ξ (B (n + 1)) ∧
      (q.coeff n : Q) = sys.germAt ξ (B n) + (n + 1 : ℕ) •
        (sys.germAt ξ (B (n + 1) * X) - sys.germAt ξ (B (n + 1)) * sys.germ X) := by
  let W := ∑ k ∈ Finset.range (n + 2), B k * X ^ k
  have hW : sys.germ W = 0 := by
    rw [← hp, aeval_eq_sum_range' (show p.natDegree < n + 2 by omega), map_sum]
    exact Finset.sum_congr rfl fun i _ ↦ by
      rw [map_mul, map_pow, hB, Algebra.smul_def, Subalgebra.algebraMap_apply]
  obtain ⟨ε, hε, hvan⟩ := sys.germAt_eventually_eq_zero W ⟨0, by rw [map_zero, hW]⟩
  refine ⟨ε, hε, fun ξ hlo hhi ↦ ?_⟩
  have hzero : sys.germAt ξ W = 0 := by
    rcases hhi.lt_or_eq with h | rfl
    · exact hvan ξ hlo h
    · rwa [sys.germAt_zero]
  choose q hdeg hval hlead hnext using fun k ↦
    sys.binomial_expansion S X hX (B k) (hs k) k ξ
  refine ⟨∑ k ∈ Finset.range (n + 2), q k, ?_, ?_, ?_, ?_⟩
  · exact natDegree_sum_le_of_forall_le _ _ fun k hk ↦
      (hdeg k).trans (Nat.le_of_lt_succ (Finset.mem_range.mp hk))
  · rw [← hzero, map_sum, map_sum]
    exact Finset.sum_congr rfl fun k _ ↦ hval k
  · rw [finsetSum_coeff, AddSubmonoidClass.coe_finsetSum,
      Finset.sum_eq_single_of_mem (n + 1) (Finset.mem_range.mpr (by omega))]
    · exact hlead _
    · intro k hk hne
      have := Finset.mem_range.mp hk
      rw [coeff_eq_zero_of_natDegree_lt ((hdeg k).trans_lt (by omega)), Subalgebra.coe_zero]
  · rw [finsetSum_coeff, AddSubmonoidClass.coe_finsetSum, Finset.sum_range_succ,
      Finset.sum_range_succ, Finset.sum_eq_zero, zero_add, hlead n]
    · simpa only [Nat.add_sub_cancel] using congrArg (sys.germAt ξ (B n) + ·)
        (hnext (n + 1) (by omega))
    · intro k hk
      have := Finset.mem_range.mp hk
      rw [coeff_eq_zero_of_natDegree_lt ((hdeg k).trans_lt (by omega)), Subalgebra.coe_zero]

/-- A polynomial relation of positive degree gives a monic relation of the same degree. -/
theorem exists_monic_relation (S : Subalgebra K Q) (X : A)
    (hS : sys.HasRepresentativesWithGermsIn S) (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S)
    {n : ℕ} (p : Polynomial ↥S) (hd : p.natDegree = n + 1) (hp : p ≠ 0)
    (heval : aeval (sys.germ X) p = 0) :
    ∃ q : Polynomial ↥S, q.natDegree = n + 1 ∧ q.Monic ∧
      aeval (sys.germ X) q = 0 := by
  choose B hB hs using fun i ↦ hS _ (p.coeff i).2
  obtain ⟨ε, hε, hrel⟩ := relations_near_zero sys S X hX p hd.le heval B hB hs
  have hlead : sys.germ (B (n + 1)) ≠ 0 := by
    rw [hB, ← hd, coeff_natDegree, ne_eq, Subalgebra.coe_eq_zero]
    exact leadingCoeff_ne_zero.mpr hp
  obtain ⟨ξ, hlo, hhi, k, hk, hξ⟩ := sys.exists_germAt_eq_scalar sys.germSupport_isWF _ hlead hε
  obtain ⟨q, hdeg, hval, hq, -⟩ := hrel ξ hlo hhi
  let m := C (algebraMap K S k⁻¹) * q
  have hm : m.natDegree ≤ n + 1 := (natDegree_C_mul_le ..).trans hdeg
  have hc : m.coeff (n + 1) = 1 := by
    apply Subtype.ext
    dsimp only [m]
    simp only [coeff_C_mul, Subalgebra.coe_mul, Subalgebra.coe_algebraMap, Subalgebra.coe_one,
      hq, hξ, ← map_mul, inv_mul_cancel₀ hk, map_one]
  refine ⟨m, natDegree_eq_of_le_of_coeff_ne_zero hm (hc ▸ one_ne_zero),
    monic_of_natDegree_le_of_coeff_eq_one _ hm hc, ?_⟩
  rw [show m = _ * q from rfl, map_mul, hval, mul_zero]

/-- No nonzero element of the subalgebra multiplies a new germ into the subalgebra. -/
theorem mul_germ_notMem (S : Subalgebra K Q) (hS : sys.HasRepresentativesWithGermsIn S)
    (X : A) (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) (hx : sys.germ X ∉ S)
    (a : Q) (ha : a ∈ S) (ha0 : a ≠ 0) : a * sys.germ X ∉ S := by
  intro hax
  let x := sys.germ X
  let p : Polynomial S :=
    Polynomial.C ⟨a, ha⟩ * Polynomial.X + Polynomial.C ⟨-(a * x), S.neg_mem hax⟩
  have hdeg : p.natDegree = 1 := natDegree_linear (fun h ↦ ha0 (congrArg Subtype.val h))
  have hp : p ≠ 0 := fun h ↦ by simp [h] at hdeg
  have hval : aeval x p = 0 := by simp [p, Subalgebra.algebraMap_apply]
  obtain ⟨q, hq, hm, hr⟩ := sys.exists_monic_relation S X hS hX
    (n := 0) p hdeg hp hval
  rw [hm.eq_X_add_C hq, map_add, aeval_X, aeval_C, Subalgebra.algebraMap_apply] at hr
  apply hx
  rw [eq_neg_of_add_eq_zero_left hr]
  exact S.neg_mem (q.coeff 0).2

/-- A germ outside a subalgebra is transcendental over it when all earlier germs belong to the
subalgebra, its elements have representatives with germs in it, and relations of positive degree
can be made monic without raising their degree. -/
theorem transcendental_germ [CharZero K] (S : Subalgebra K Q) (X : A)
    (hS : sys.HasRepresentativesWithGermsIn S) (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S)
    (hx : sys.germ X ∉ S)
    (hmonic : ∀ {n : ℕ} (p : Polynomial ↥S), p.natDegree = n + 1 → p ≠ 0 →
      aeval (sys.germ X) p = 0 → ∃ q : Polynomial ↥S, q.natDegree = n + 1 ∧ q.Monic ∧
        aeval (sys.germ X) q = 0) : Transcendental S (sys.germ X) := by
  classical
  rw [transcendental_iff]
  intro p hp
  by_contra hne
  let D (n : ℕ) := ∃ p : Polynomial ↥S, p.natDegree = n ∧ p ≠ 0 ∧ aeval (sys.germ X) p = 0
  have hD : ∃ n, D n := ⟨_, p, rfl, hne, hp⟩
  obtain ⟨p, hd, hp, hval⟩ := Nat.find_spec hD
  have hmin : ∀ i < Nat.find hD, ¬ D i := fun _ hi ↦ Nat.find_min hD hi
  generalize Nat.find hD = d at hd hmin
  cases d with
  | zero =>
    rw [eq_C_of_natDegree_eq_zero hd, aeval_C, Subalgebra.algebraMap_apply] at hval
    exact hp (by rw [eq_C_of_natDegree_eq_zero hd, (Subalgebra.coe_eq_zero S).mp hval, map_zero])
  | succ n =>
    obtain ⟨q, hqdeg, hqmonic, hqval⟩ := hmonic p hd hp hval
    have hqlead : q.coeff (n + 1) = 1 := hqdeg ▸ hqmonic.coeff_natDegree
    have hreps (i : ℕ) : ∃ B : A, sys.germ B = ↑(q.coeff i) ∧
        (∀ ξ, sys.germAt ξ B ∈ S) ∧ (i = n + 1 → B = 1) := by
      by_cases hi : i = n + 1
      · subst i
        refine ⟨1, by rw [map_one, hqlead, Subalgebra.coe_one], fun ξ ↦ ?_, fun _ ↦ rfl⟩
        rcases eq_or_ne ξ 0 with rfl | h
        · rw [sys.germAt_zero, map_one]; exact S.one_mem
        · rw [show (1 : A) = algebraMap K A 1 by rw [map_one], sys.germAt_algebraMap _ _ h]
          exact S.zero_mem
      · obtain ⟨b, hb, hs⟩ := hS _ (q.coeff i).2
        exact ⟨b, hb, hs, fun e ↦ (hi e).elim⟩
    choose B hB hs hone using hreps
    obtain ⟨ε, hε, hrel⟩ := relations_near_zero sys S X hX q hqdeg.le hqval B hB hs
    have hscalar := sys.germ_mem_range_of_eventually (B n + (n + 1) • X)
      ⟨ε, hε, fun ξ hlo hhi ↦ by
        obtain ⟨r, hrdeg, hrval, hrlead, hrnext⟩ := hrel ξ hlo hhi.le
        have htop : sys.germAt ξ (B (n + 1)) = 0 := by
          rw [hone _ rfl, show (1 : A) = algebraMap K A 1 by rw [map_one]]
          exact sys.germAt_algebraMap _ _ hhi.ne
        have hr : r = 0 := by
          by_contra hr
          have hlt : r.natDegree < n + 1 := lt_of_le_of_ne hrdeg fun he ↦ by
            have : (r.coeff (n + 1) : Q) ≠ 0 := by
              rw [← he, coeff_natDegree, ne_eq, Subalgebra.coe_eq_zero]
              exact leadingCoeff_ne_zero.mpr hr
            exact this (hrlead.trans htop)
          exact hmin _ hlt ⟨r, rfl, hr, hrval⟩
        rw [hr, coeff_zero, Subalgebra.coe_zero, htop, zero_mul, sub_zero,
          hone _ rfl, one_mul] at hrnext
        simpa only [map_add, map_nsmul] using hrnext.symm⟩
    obtain ⟨k, hk⟩ := hscalar
    have hmem : (n + 1) • sys.germ X ∈ S := by
      rw [map_add, map_nsmul, hB] at hk
      rw [show (n + 1) • sys.germ X = algebraMap K Q k - ↑(q.coeff n) by
        linear_combination -hk]
      exact S.sub_mem (S.algebraMap_mem k) (q.coeff n).2
    have hnk : ((n + 1 : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero n)
    apply hx
    convert S.smul_mem hmem (((n + 1 : ℕ) : K)⁻¹) using 1
    rw [← Nat.cast_smul_eq_nsmul K, smul_smul, inv_mul_cancel₀ hnk, one_smul]

variable [CharZero K]

include sys in
/-- The ring of germs is a polynomial ring over `K`: it has an algebraically independent set of
generators. -/
theorem exists_algebraicIndependent_generators :
    ∃ T : Set Q, AlgebraicIndependent K ((↑) : T → Q) ∧ Algebra.adjoin K T = ⊤ :=
  exists_algebraicIndependent_adjoin_eq_top sys.HasRepresentativesWithGermsIn
    sys.hasRepresentativesWithGermsIn_bot
    (fun _ hcn hchain hc => sys.hasRepresentativesWithGermsIn_adjoin_sUnion hcn hchain hc)
    fun S _ hS hne => by
      obtain ⟨X, hX, _, hx⟩ := sys.exists_germAt_mem_germ_mem_notMem sys.germSupport_isWF
        sys.exists_translatedTruncation sys.hasRepresentativesWithGermsIn_top
        (lt_top_iff_ne_top.mpr hne)
      exact ⟨sys.germ X, sys.transcendental_germ S X hS hX hx (sys.exists_monic_relation S X hS hX),
        sys.hasRepresentativesWithGermsIn_adjoin S hS X hX⟩

end TruncationGerms

namespace TruncationGerms

variable {K Γ : Type*} [Field K] [CharZero K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]

/-- The ring of germs `Q` is isomorphic to a polynomial ring over `K`. The universe of the
variables may be enlarged freely. -/
theorem exists_mvPolynomial_algEquiv {Q : Type u} [CommRing Q] [Nontrivial Q] [Algebra K Q]
    {A : Type*} [CommRing A] [Algebra K A] (sys : TruncationGerms K Γ A Q) :
    ∃ ι : Type (max u w), Nonempty (MvPolynomial ι K ≃ₐ[K] Q) := by
  obtain ⟨T, hind, htop⟩ := sys.exists_algebraicIndependent_generators
  exact ⟨ULift.{w} T, ⟨(MvPolynomial.renameEquiv K Equiv.ulift).trans
    (hind.mvPolynomialAlgEquivOfAdjoinEqTop htop)⟩⟩

/-- The ring of germs is an integral domain, being a polynomial ring over a field. -/
theorem isDomain {Q : Type*} [CommRing Q] [Nontrivial Q] [Algebra K Q]
    {A : Type*} [CommRing A] [Algebra K A] (sys : TruncationGerms K Γ A Q) : IsDomain Q := by
  obtain ⟨T, hind, htop⟩ := sys.exists_algebraicIndependent_generators
  exact (hind.mvPolynomialAlgEquivOfAdjoinEqTop htop).symm.toMulEquiv.isDomain _

end TruncationGerms

