/-!
# Germs of translated truncations: transcendence and the ring of germs

From the axioms of `TruncationGerms`, the ring of germs `Q` is a polynomial ring over `K`; in
particular it is an integral domain (`isDomain`), although this is not assumed.

The transcendence lemma (`transcendental_germ`) fixes a subalgebra `S` of `Q` that is an integral
domain and has representatives whose germs lie in `S`, and a series `X` whose germs at negative
exponents lie in `S` but whose germ `x` does not: then `x` is transcendental over `S`. First, no
nonzero `a ∈ S` has `a * x ∈ S`; hence `S + S x` is a free `S`-module on `1, x`, and nonzero
elements of `S` cancel from its elements. A minimal polynomial relation is pushed through the germ
maps; characteristic zero reduces it to a relation of degree one, which the proportionality lemma
(`exists_germ_eq_smul_of_proportional`, an induction on `rank` whose cancellations all take place in
`S + S x`) rules out. A Zorn argument on algebraically independent generating sets then shows that
the ring of germs is a polynomial ring (`exists_algebraicIndependent_generators`,
`exists_mvPolynomial_algEquiv`); at each step the subalgebra generated by an algebraically
independent set is a polynomial ring, hence an integral domain.
-/

universe u w

public section

/-- An algebraically independent generating set presents an algebra as a polynomial ring. -/
noncomputable def AlgebraicIndependent.mvPolynomialAlgEquivOfAdjoinEqTop {R B : Type*} [CommRing R]
    [CommRing B] [Algebra R B] {T : Set B} (hind : AlgebraicIndependent R ((↑) : T → B))
    (htop : Algebra.adjoin R T = ⊤) : MvPolynomial T R ≃ₐ[R] B :=
  have hr : Algebra.adjoin R (Set.range ((↑) : T → B)) = ⊤ := by
    rw [Subtype.range_coe_subtype, Set.setOf_mem_eq]; exact htop
  hind.aevalEquiv.trans ((Subalgebra.equivOfEq _ _ hr).trans Subalgebra.topEquiv)

/-- The subalgebra generated by an algebraically independent set over an integral domain is an
integral domain: it is isomorphic to a polynomial ring. -/
theorem AlgebraicIndependent.isDomain_adjoin {R B : Type*} [CommRing R] [IsDomain R]
    [CommRing B] [Algebra R B] {T : Set B} (hind : AlgebraicIndependent R ((↑) : T → B)) :
    IsDomain (Algebra.adjoin R T) :=
  have hr : Algebra.adjoin R (Set.range ((↑) : T → B)) = Algebra.adjoin R T := by
    rw [Subtype.range_coe_subtype, Set.setOf_mem_eq]
  (hind.aevalEquiv.trans (Subalgebra.equivOfEq _ _ hr)).symm.toMulEquiv.isDomain _

namespace TruncationGerms

variable {K Γ A Q : Type*} [Field K] [CharZero K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]
  [CommRing A] [Algebra K A] [CommRing Q] [Nontrivial Q] [Algebra K Q]
  (sys : TruncationGerms K Γ A Q)

omit [CharZero K] [Nontrivial Q] in
/-- In a subalgebra that is an integral domain, a nonzero factor cancels from a vanishing
product. -/
private theorem eq_zero_of_mul_eq_zero (S : Subalgebra K Q) [IsDomain S] {a b : Q} (ha : a ∈ S)
    (hb : b ∈ S) (ha0 : a ≠ 0) (h : a * b = 0) : b = 0 := by
  have h' : (⟨a, ha⟩ : S) * ⟨b, hb⟩ = 0 := Subtype.ext h
  rcases mul_eq_zero.mp h' with h1 | h1
  · exact absurd (congrArg Subtype.val h1) ha0
  · exact congrArg Subtype.val h1

omit [CharZero K] [Nontrivial Q] in
/-- The elements `s₀ + s₁ * x` with `s₀ s₁ ∈ S` are stable under multiplication by `S`. -/
private theorem exists_mul_eq_add_mul (S : Subalgebra K Q) {x a n : Q} (ha : a ∈ S)
    (hn : ∃ s₀ ∈ S, ∃ s₁ ∈ S, n = s₀ + s₁ * x) : ∃ s₀ ∈ S, ∃ s₁ ∈ S, a * n = s₀ + s₁ * x := by
  obtain ⟨s₀, h₀, s₁, h₁, rfl⟩ := hn
  exact ⟨a * s₀, S.mul_mem ha h₀, a * s₁, S.mul_mem ha h₁, by ring⟩

omit [CharZero K] [Nontrivial Q] in
/-- Let `S` be an integral domain and `x` an element such that no nonzero `a ∈ S` has `a * x ∈ S`.
Then `S + S x` is a free `S`-module on `1, x`, so nonzero elements of `S` cancel from products
with its elements. -/
private theorem cancel_of_mul_notMem (S : Subalgebra K Q) [IsDomain S] {x : Q}
    (hx : ∀ a ∈ S, a ≠ 0 → a * x ∉ S) {v n n' : Q} (hv : v ∈ S) (hv0 : v ≠ 0)
    (hn : ∃ s₀ ∈ S, ∃ s₁ ∈ S, n = s₀ + s₁ * x) (hn' : ∃ s₀ ∈ S, ∃ s₁ ∈ S, n' = s₀ + s₁ * x)
    (h : v * n = v * n') : n = n' := by
  obtain ⟨s₀, h₀, s₁, h₁, rfl⟩ := hn
  obtain ⟨s₀', h₀', s₁', h₁', rfl⟩ := hn'
  have h1 : v * (s₁ - s₁') = 0 := by
    by_contra hne
    refine hx _ (S.mul_mem hv (S.sub_mem h₁ h₁')) hne ?_
    have : v * (s₁ - s₁') * x = -(v * (s₀ - s₀')) := by linear_combination h
    rw [this]
    exact neg_mem (S.mul_mem hv (S.sub_mem h₀ h₀'))
  have h0 : v * (s₀ - s₀') = 0 := by linear_combination h - x * h1
  have e1 := eq_zero_of_mul_eq_zero S hv (S.sub_mem h₁ h₁') hv0 h1
  have e0 := eq_zero_of_mul_eq_zero S hv (S.sub_mem h₀ h₀') hv0 h0
  linear_combination e0 + x * e1

/-- **Proportionality.** Let `S` be a subalgebra of the ring of germs that is an integral domain,
and let `x` be an element such that no nonzero `a ∈ S` has `a * x ∈ S`. Let `V` be a series with
nonzero germ whose germs at nonpositive exponents lie in `S`, and `U` a series whose germs at
nonpositive exponents have the form `s₀ + s₁ * x` with `s₀ s₁ ∈ S`. If the germs of `U` and `V` at
the exponents of a left neighbourhood of `0` are in the ratio `germ U : germ V`, then `germ U` is a
constant multiple of `germ V`. -/
@[blueprint "lem:proportionality"
  (phase := "Polynomial presentations")
  (title := "Proportionality lemma")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on $A$ with values in $Q$
    (\ref{def:germ-axioms}).  Let $S\subseteq Q$ be a $K$-subalgebra that is an
    integral domain, and let $x\in Q$ be such that $ax\notin S$ for every
    nonzero $a\in S$.  Let $U,V\in A$ with $[V]\ne0$, with $g_\xi(V)\in S$ for
    all $\xi\le0$, and with $g_\xi(U)\in S+Sx$ for all $\xi\le0$.  If there is
    $\varepsilon<0$ such that
    \[
      [V]\,g_\xi(U)=[U]\,g_\xi(V)\qquad\text{for all }\xi\in(\varepsilon,0),
    \]
    then $[U]=c\,[V]$ for some $c\in K$.
  -/)
  (proof := /--
    The hypothesis on $x$ makes $S+Sx$ a free $S$-module with basis $1,x$, so a
    nonzero element of $S$ can be cancelled from an equation $vn=vn'$ with
    $n,n'\in S+Sx$.  Induct on $\operatorname{rk}[V]$, using the axioms of
    \ref{def:germ-axioms}.  If $[V]=k\in K^\times$, then $g_\xi(V)=0$ near $0$
    by axiom (4), so the relation gives $g_\xi(U)=0$ near $0$ and $[U]\in K$.
    Otherwise axiom (5) bounds the rank of $g_\xi(V)$ below
    $\operatorname{rk}[V]$ near $0$, and axiom (4) provides such $\xi$ in
    $(\varepsilon,0)$ with $g_\xi(V)\ne0$.  Let $U',V'$ be the translated
    truncations at $\xi$ given by axiom (3).  For $\zeta<0$ close to $0$, the
    relations at $\xi+\zeta$ and at $\xi$, after cancelling $[V]$ in $S+Sx$,
    give $[V']\,g_\zeta(U')=[U']\,g_\zeta(V')$.  By induction
    $g_\xi(U)=[U']=c\,[V']=c\,g_\xi(V)$, and cancelling $g_\xi(V)\ne0$ from the
    relation at $\xi$ gives $[U]=c\,[V]$.
  -/)]
theorem exists_germ_eq_smul_of_proportional (S : Subalgebra K Q) [IsDomain S] {x : Q}
    (hx : ∀ a ∈ S, a ≠ 0 → a * x ∉ S) (U V : A) (hV : sys.germ V ≠ 0)
    (hVS : ∀ ξ ≤ 0, sys.germAt ξ V ∈ S)
    (hUN : ∀ ξ ≤ 0, ∃ s₀ ∈ S, ∃ s₁ ∈ S, sys.germAt ξ U = s₀ + s₁ * x)
    (h : ∃ ε < 0, ∀ ξ, ε < ξ → ξ < 0 →
      sys.germ V * sys.germAt ξ U = sys.germ U * sys.germAt ξ V) :
    ∃ c : K, sys.germ U = c • sys.germ V := by
  suffices H : ∀ (o : Ordinal), ∀ (U V : A), sys.germ V ≠ 0 →
      (∀ ξ ≤ 0, sys.germAt ξ V ∈ S) →
      (∀ ξ ≤ 0, ∃ s₀ ∈ S, ∃ s₁ ∈ S, sys.germAt ξ U = s₀ + s₁ * x) →
      sys.rank (sys.germ V) = o →
      (∃ ε < 0, ∀ ξ, ε < ξ → ξ < 0 →
        sys.germ V * sys.germAt ξ U = sys.germ U * sys.germAt ξ V) →
      ∃ c : K, sys.germ U = c • sys.germ V by
    exact H _ U V hV hVS hUN rfl h
  intro o
  induction o using WellFoundedLT.induction with
  | _ o IH =>
    intro U V hV hVS hUN ho h
    obtain ⟨ε, hε, hrel⟩ := h
    have hvS : sys.germ V ∈ S := by rw [← sys.germAt_zero]; exact hVS 0 le_rfl
    have huN : ∃ s₀ ∈ S, ∃ s₁ ∈ S, sys.germ U = s₀ + s₁ * x := by
      rw [← sys.germAt_zero]; exact hUN 0 le_rfl
    by_cases hVc : sys.germ V ∈ Set.range (algebraMap K Q)
    · -- `V` is constant.
      obtain ⟨ε₁, hε₁, hV0⟩ := sys.germAt_eventually_eq_zero V hVc
      obtain ⟨cv, hcv⟩ := hVc
      have hcv0 : cv ≠ 0 := by
        rintro rfl; rw [map_zero] at hcv; exact hV hcv.symm
      have hmax : max ε ε₁ < 0 := max_lt hε hε₁
      have hU0 : ∀ ξ, max ε ε₁ < ξ → ξ < 0 → sys.germAt ξ U = 0 := by
        intro ξ hξlo hξhi
        have hξε : ε < ξ := lt_of_le_of_lt (le_max_left _ _) hξlo
        have hξε₁ : ε₁ < ξ := lt_of_le_of_lt (le_max_right _ _) hξlo
        have e1 := hrel ξ hξε hξhi
        rw [hV0 ξ hξε₁ hξhi, mul_zero] at e1
        calc sys.germAt ξ U = algebraMap K Q cv⁻¹ * (sys.germ V * sys.germAt ξ U) := by
              rw [← hcv, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hcv0, map_one, one_mul]
          _ = 0 := by rw [e1, mul_zero]
      have hUc : sys.germ U ∈ Set.range (algebraMap K Q) :=
        sys.germ_mem_range_of_eventually U ⟨max ε ε₁, hmax, hU0⟩
      obtain ⟨cu, hcu⟩ := hUc
      refine ⟨cu * cv⁻¹, ?_⟩
      rw [Algebra.smul_def, ← hcu, ← hcv, ← map_mul]
      congr 1
      field_simp
    · -- `V` is not constant.
      obtain ⟨ε₁, hε₁, hrank⟩ := sys.rank_germAt_lt V hVc
      have hex : ∃ ξ, max ε ε₁ < ξ ∧ ξ < 0 ∧ sys.germAt ξ V ≠ 0 := by
        by_contra hcon
        simp only [not_exists, not_and, not_not] at hcon
        exact hVc (sys.germ_mem_range_of_eventually V ⟨max ε ε₁, max_lt hε hε₁, hcon⟩)
      obtain ⟨ξ, hξlo, hξhi, hξV⟩ := hex
      have hξε : ε < ξ := lt_of_le_of_lt (le_max_left _ _) hξlo
      have hξε₁ : ε₁ < ξ := lt_of_le_of_lt (le_max_right _ _) hξlo
      have hrankξ : sys.rank (sys.germAt ξ V) < sys.rank (sys.germ V) := hrank ξ hξε₁ hξhi
      have hξ0 : ξ ≤ 0 := le_of_lt hξhi
      obtain ⟨U', hU'⟩ := sys.exists_translatedTruncation U ξ hξ0
      obtain ⟨V', hV'⟩ := sys.exists_translatedTruncation V ξ hξ0
      have hgU' : sys.germ U' = sys.germAt ξ U := by
        rw [← sys.germAt_zero U']; have := hU' 0 le_rfl; rwa [add_zero] at this
      have hgV' : sys.germ V' = sys.germAt ξ V := by
        rw [← sys.germAt_zero V']; have := hV' 0 le_rfl; rwa [add_zero] at this
      have hV'ne : sys.germ V' ≠ 0 := by rw [hgV']; exact hξV
      have hV'S : ∀ ζ ≤ 0, sys.germAt ζ V' ∈ S := fun ζ hζ => by
        rw [hV' ζ hζ]; exact hVS _ (add_nonpos hξ0 hζ)
      have hU'N : ∀ ζ ≤ 0, ∃ s₀ ∈ S, ∃ s₁ ∈ S, sys.germAt ζ U' = s₀ + s₁ * x := fun ζ hζ => by
        rw [hU' ζ hζ]; exact hUN _ (add_nonpos hξ0 hζ)
      have hcross : sys.germ V * sys.germAt ξ U = sys.germ U * sys.germAt ξ V :=
        hrel ξ hξε hξhi
      have hnewrel : ∃ ε' < 0, ∀ ζ, ε' < ζ → ζ < 0 →
          sys.germ V' * sys.germAt ζ U' = sys.germ U' * sys.germAt ζ V' := by
        refine ⟨ε - ξ, sub_neg_of_lt hξε, ?_⟩
        intro ζ hζlo hζhi
        have hζ0 : ζ ≤ 0 := le_of_lt hζhi
        have hha : ε < ξ + ζ := sub_lt_iff_lt_add'.mp hζlo
        have hhb : ξ + ζ < 0 := add_neg_of_neg_of_nonpos hξhi hζ0
        have e := hrel (ξ + ζ) hha hhb
        rw [← hU' ζ hζ0, ← hV' ζ hζ0] at e
        rw [hgU', hgV']
        refine cancel_of_mul_notMem S hx hvS hV
          (exists_mul_eq_add_mul S (hVS ξ hξ0) (hU'N ζ hζ0)) ?_ ?_
        · rw [mul_comm]; exact exists_mul_eq_add_mul S (hV'S ζ hζ0) (hUN ξ hξ0)
        calc sys.germ V * (sys.germAt ξ V * sys.germAt ζ U')
            = sys.germAt ξ V * (sys.germ V * sys.germAt ζ U') := by ring
          _ = sys.germAt ξ V * (sys.germ U * sys.germAt ζ V') := by rw [e]
          _ = (sys.germ U * sys.germAt ξ V) * sys.germAt ζ V' := by ring
          _ = (sys.germ V * sys.germAt ξ U) * sys.germAt ζ V' := by rw [← hcross]
          _ = sys.germ V * (sys.germAt ξ U * sys.germAt ζ V') := by ring
      have hlt : sys.rank (sys.germ V') < o := by rw [hgV', ← ho]; exact hrankξ
      obtain ⟨c, hc⟩ := IH (sys.rank (sys.germ V')) hlt U' V' hV'ne hV'S hU'N rfl hnewrel
      refine ⟨c, ?_⟩
      rw [hgU', hgV'] at hc
      refine cancel_of_mul_notMem S hx (hVS ξ hξ0) hξV huN
        ⟨c • sys.germ V, S.smul_mem hvS c, 0, zero_mem S, by rw [zero_mul, add_zero]⟩ ?_
      rw [mul_comm, ← hcross, hc, mul_smul_comm, mul_smul_comm, mul_comm]

/-- Adjoining the germ of `X` to `S` preserves the existence of representatives with germs in the
subalgebra. -/
private theorem hasRepresentativesWithGermsIn_adjoin (S : Subalgebra K Q)
    (hS : sys.HasRepresentativesWithGermsIn S) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) :
    sys.HasRepresentativesWithGermsIn (Algebra.adjoin K (insert (sys.germ X) (S : Set Q))) := by
  set x := sys.germ X with hxdef
  set Sx := Algebra.adjoin K (insert x (S : Set Q)) with hSxdef
  have hS_le : ∀ a ∈ S, a ∈ Sx := fun a ha =>
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ ha)
  intro a ha
  induction ha using Algebra.adjoin_induction with
  | mem a h =>
    rcases Set.mem_insert_iff.mp h with rfl | h
    · -- a = x
      refine ⟨X, rfl, fun ξ => ?_⟩
      rcases lt_trichotomy ξ 0 with hξ | rfl | hξ
      · exact hS_le _ (hX ξ hξ)
      · rw [sys.germAt_zero X]; exact Algebra.subset_adjoin (Set.mem_insert _ _)
      · rw [sys.germAt_of_pos X ξ hξ]; exact zero_mem Sx
    · -- a ∈ S
      obtain ⟨b, hb, hbs⟩ := hS a h
      exact ⟨b, hb, fun ξ => hS_le _ (hbs ξ)⟩
  | algebraMap r =>
    obtain ⟨b, hb, hbs⟩ := hS (algebraMap K Q r) (Subalgebra.algebraMap_mem S r)
    exact ⟨b, hb, fun ξ => hS_le _ (hbs ξ)⟩
  | add a a' _ _ Pa Pa' =>
    obtain ⟨b, hb, hbs⟩ := Pa
    obtain ⟨b', hb', hbs'⟩ := Pa'
    refine ⟨b + b', by rw [map_add, hb, hb'], fun ξ => ?_⟩
    rw [map_add]; exact Sx.add_mem (hbs ξ) (hbs' ξ)
  | mul a a' _ _ Pa Pa' =>
    obtain ⟨b, hb, hbs⟩ := Pa
    obtain ⟨b', hb', hbs'⟩ := Pa'
    refine ⟨b * b', by rw [map_mul, hb, hb'], fun ξ => ?_⟩
    rw [sys.convolution b b' ξ]
    exact sys.finsum_convolution_mem Sx b b' ξ hbs hbs'

/-- Let `S` be a subalgebra of the ring of germs whose elements are germs of series with all germs
in `S`, and let `X` be a series whose germs at negative exponents lie in `S` but whose germ does
not. Then no nonzero element of `S` multiplies the germ of `X` into `S`. -/
@[blueprint "lem:no-linear-relations"
  (phase := "Polynomial presentations")
  (title := "Absence of linear relations")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on $A$ with values in $Q$
    (\ref{def:germ-axioms}).  Let $S\subseteq Q$ be a $K$-subalgebra such that
    every element of $S$ is $[b]$ for some $b\in A$ with $g_\xi(b)\in S$ for all
    $\xi$.  Let $X\in A$ with $g_\xi(X)\in S$ for all $\xi<0$ and
    $x=[X]\notin S$.  Then $ax\notin S$ for every nonzero $a\in S$.
  -/)
  (proof := /--
    Suppose otherwise and take a counterexample $a$ of minimal rank.  Choose
    $A_0$ representing $a$ and $B$ representing $-ax$, both with all germs in
    $S$.  Then $[A_0X+B]=0$, so by axiom (4) of \ref{def:germ-axioms} the germs
    of $A_0X+B$ vanish on some $(\varepsilon,0)$.  For $\xi$ in this interval,
    the convolution formula (axiom (2)) gives
    $g_\xi(A_0X)\in g_\xi(A_0)\,x+S$, because every other term pairs a germ of
    $A_0$ with a germ of $X$ at a negative or positive exponent; hence
    $g_\xi(A_0)\in S$ and $g_\xi(A_0)\,x\in S$.  If $a\in K$, then
    $x=a^{-1}(ax)\in S$, a contradiction.  Otherwise axiom (5) gives
    $\operatorname{rk}g_\xi(A_0)<\operatorname{rk}a$ for $\xi$ near $0$, so
    minimality forces $g_\xi(A_0)=0$ near $0$, and axiom (4) puts $a$ in $K$
    after all.
  -/)]
theorem mul_germ_notMem (S : Subalgebra K Q) (hS : sys.HasRepresentativesWithGermsIn S)
    (X : A) (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) (hx : sys.germ X ∉ S)
    (a : Q) (ha : a ∈ S) (ha0 : a ≠ 0) : a * sys.germ X ∉ S := by
  intro hax
  set x := sys.germ X with hxdef
  suffices H :
      ∀ (o : Ordinal), ∀ a : Q,
        a ∈ S → a ≠ 0 → a * x ∈ S → sys.rank a = o → False by
    exact H _ a ha ha0 hax rfl
  intro o
  induction o using WellFoundedLT.induction with
  | _ o IH =>
    intro a ha ha0 hax ho
    obtain ⟨A₀, hA₀g, hA₀s⟩ := hS a ha
    obtain ⟨B, hBg, hBs⟩ := hS (-(a * x)) (neg_mem hax)
    -- `W = A₀ X + B` has germ `0`.
    have hgermW : sys.germ (A₀ * X + B) = 0 := by
      rw [map_add, map_mul, hA₀g, hBg, ← hxdef]; ring
    obtain ⟨ε, hε, hW0⟩ :=
      sys.germAt_eventually_eq_zero (A₀ * X + B) ⟨0, by rw [map_zero, hgermW]⟩
    -- For `ξ ∈ (ε, 0)`: `L ξ A₀ ∈ S` and `(L ξ A₀) * x ∈ S`.
    have key : ∀ ξ, ε < ξ → ξ < 0 →
        sys.germAt ξ A₀ ∈ S ∧ sys.germAt ξ A₀ * x ∈ S := by
      intro ξ hξlo hξhi
      refine ⟨hA₀s ξ, ?_⟩
      have hc : sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * x ∈ S :=
        sys.offDiagonal_mem S hX A₀ hA₀s
      have hWξ : sys.germAt ξ (A₀ * X) + sys.germAt ξ B = 0 := by
        have := hW0 ξ hξlo hξhi
        rwa [map_add] at this
      have : sys.germAt ξ A₀ * x =
          -(sys.germAt ξ B) - (sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * x) := by
        linear_combination hWξ
      rw [this]
      exact S.sub_mem (neg_mem (hBs ξ)) hc
    by_cases hac : a ∈ Set.range (algebraMap K Q)
    · -- `a` is constant: forces `x ∈ S`.
      obtain ⟨k, hk⟩ := hac
      have hk0 : k ≠ 0 := by rintro rfl; rw [map_zero] at hk; exact ha0 hk.symm
      have hxmem : x ∈ S := by
        have hxeq : x = k⁻¹ • (a * x) := by
          rw [← hk, Algebra.smul_def, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hk0,
            map_one, one_mul]
        rw [hxeq]; exact Subalgebra.smul_mem S hax k⁻¹
      exact hx hxmem
    · -- `a` is not constant: germs have strictly smaller rank, apply IH.
      obtain ⟨ε', hε', hrank⟩ := sys.rank_germAt_lt A₀ (by rwa [hA₀g])
      have hvanish : ∀ ξ, max ε ε' < ξ → ξ < 0 → sys.germAt ξ A₀ = 0 := by
        intro ξ hξlo hξhi
        have hξε : ε < ξ := lt_of_le_of_lt (le_max_left _ _) hξlo
        have hξε' : ε' < ξ := lt_of_le_of_lt (le_max_right _ _) hξlo
        obtain ⟨hmem, hmul⟩ := key ξ hξε hξhi
        by_contra hne
        have hr : sys.rank (sys.germAt ξ A₀) < o := by
          rw [← ho, ← hA₀g]; exact hrank ξ hξε' hξhi
        exact IH _ hr (sys.germAt ξ A₀) hmem hne hmul rfl
      exact hac
        (hA₀g ▸
          sys.germ_mem_range_of_eventually A₀ ⟨max ε ε', max_lt hε hε', hvanish⟩)

open Polynomial in
/-- A truncated Taylor expansion of the germs of `A₀ * X ^ k`. There is a polynomial
over `S` of degree at most `k` whose evaluation at the germ of `X` recovers `L ξ (A₀ * X ^ k)`,
with leading coefficient `L ξ A₀` and subleading coefficient `k` times the first-order
correction of `A₀`. -/
private theorem expansion (S : Subalgebra K Q) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) (A₀ : A) (h0 : ∀ ξ, sys.germAt ξ A₀ ∈ S) :
    ∀ (k : ℕ) (ξ : Γ), ξ ≤ 0 → ∃ q : Polynomial ↥S,
      q.natDegree ≤ k ∧
      aeval (sys.germ X) q = sys.germAt ξ (A₀ * X ^ k) ∧
      (↑(q.coeff k) : Q) = sys.germAt ξ A₀ ∧
      (1 ≤ k → (↑(q.coeff (k - 1)) : Q) =
        (k : ℕ) • (sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * sys.germ X)) := by
  set x := sys.germ X with hxdef
  intro k
  induction k with
  | zero =>
    intro ξ _
    refine ⟨C ⟨sys.germAt ξ A₀, h0 ξ⟩, (natDegree_C _).le, ?_, ?_, ?_⟩
    · rw [pow_zero, mul_one, aeval_C, Subalgebra.algebraMap_apply]
    · rw [coeff_C_zero]
    · intro h; omega
  | succ k IH =>
    intro ξ hξ
    obtain ⟨qξ, hqξdeg, hqξae, hqξck, hqξck1⟩ := IH ξ hξ
    -- off-diagonal exponents only in `S`.
    have hmemS : ∀ β, β ≠ ξ → sys.germAt (ξ - β) X ∈ S := by
      intro β hβ
      rcases lt_trichotomy β ξ with h | h | h
      · rw [sys.germAt_of_pos X (ξ - β) (by simpa using sub_pos.mpr h)]; exact zero_mem S
      · exact absurd h hβ
      · exact hX _ (by simpa using sub_neg.mpr h)
    -- coefficient and polynomial functions for the off-diagonal part.
    set dfun : Γ → ↥S :=
      fun β => if h : β ≠ ξ then ⟨sys.germAt (ξ - β) X, hmemS β h⟩ else 0
      with hdf
    set qfun : Γ → Polynomial ↥S :=
      fun β => if h : β ≤ 0 then Classical.choose (IH β h) else 0
      with hqf
    set P : Γ → Polynomial ↥S := fun β => C (dfun β) * qfun β with hPdef
    -- a common index set for both convolutions.
    set s : Finset Γ :=
      (sys.convolution_finite (A₀ * X ^ k) X ξ).toFinset ∪
        (sys.convolution_finite A₀ X ξ).toFinset with hs
    set T : Finset Γ := (insert ξ s).erase ξ with hT
    set R : Polynomial ↥S := ∑ β ∈ T, P β with hR
    -- convolution decompositions over the common index set.
    have E1 : sys.germAt ξ (A₀ * X ^ k * X) = sys.germAt ξ (A₀ * X ^ k) * sys.germAt 0 X +
        ∑ β ∈ T, sys.germAt β (A₀ * X ^ k) * sys.germAt (ξ - β) X := by
      refine sys.germAt_mul_sum (A₀ * X ^ k) X ξ s (fun β hβ => ?_)
      exact Finset.mem_union_left _
        ((Set.Finite.mem_toFinset _).mpr ⟨left_ne_zero_of_mul hβ, right_ne_zero_of_mul hβ⟩)
    have E2 : sys.germAt ξ (A₀ * X) = sys.germAt ξ A₀ * sys.germAt 0 X +
        ∑ β ∈ T, sys.germAt β A₀ * sys.germAt (ξ - β) X := by
      refine sys.germAt_mul_sum A₀ X ξ s (fun β hβ => ?_)
      exact Finset.mem_union_right _
        ((Set.Finite.mem_toFinset _).mpr ⟨left_ne_zero_of_mul hβ, right_ne_zero_of_mul hβ⟩)
    have hcsum : sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * x =
        ∑ β ∈ T, sys.germAt β A₀ * sys.germAt (ξ - β) X := by
      rw [E2, sys.germAt_zero X]; ring
    -- values of the coefficient/polynomial functions.
    have hdval : ∀ β ∈ T, (↑(dfun β) : Q) = sys.germAt (ξ - β) X := by
      intro β hβ
      have hne : β ≠ ξ := Finset.ne_of_mem_erase hβ
      simp only [hdf, dif_pos hne]
    have hqae : ∀ β, aeval x (qfun β) = sys.germAt β (A₀ * X ^ k) := by
      intro β
      by_cases hle : β ≤ 0
      · simp only [hqf, dif_pos hle]; exact (Classical.choose_spec (IH β hle)).2.1
      · simp only [hqf, dif_neg hle, map_zero, sys.germAt_of_pos (A₀ * X ^ k) β (not_le.mp hle)]
    have hqdeg : ∀ β, (qfun β).natDegree ≤ k := by
      intro β
      by_cases hle : β ≤ 0
      · simp only [hqf, dif_pos hle]; exact (Classical.choose_spec (IH β hle)).1
      · simp only [hqf, dif_neg hle, natDegree_zero]; exact Nat.zero_le _
    have hqck : ∀ β, (↑((qfun β).coeff k) : Q) = sys.germAt β A₀ := by
      intro β
      by_cases hle : β ≤ 0
      · simp only [hqf, dif_pos hle]; exact (Classical.choose_spec (IH β hle)).2.2.1
      · simp only [hqf, dif_neg hle, coeff_zero, Subalgebra.coe_zero,
          sys.germAt_of_pos A₀ β (not_le.mp hle)]
    -- consequences for `P`.
    have hPdeg : ∀ β, (P β).natDegree ≤ k :=
      fun β => (natDegree_C_mul_le _ _).trans (hqdeg β)
    have hPae : ∀ β ∈ T,
        aeval x (P β) = sys.germAt β (A₀ * X ^ k) * sys.germAt (ξ - β) X := by
      intro β hβ
      simp only [hPdef, map_mul, aeval_C, Subalgebra.algebraMap_apply, hdval β hβ, hqae β]
      ring
    have hPck1 : ∀ β, (P β).coeff (k + 1) = 0 := by
      intro β
      simp only [hPdef, coeff_C_mul,
        coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt (hqdeg β) (Nat.lt_succ_self k)), mul_zero]
    have hPck : ∀ β ∈ T,
        (↑((P β).coeff k) : Q) = sys.germAt β A₀ * sys.germAt (ξ - β) X := by
      intro β hβ
      simp only [hPdef, coeff_C_mul, Subalgebra.coe_mul, hdval β hβ, hqck β]
      ring
    refine ⟨qξ * Polynomial.X + R, ?_, ?_, ?_, ?_⟩
    · -- degree
      refine (natDegree_add_le _ _).trans (max_le ?_ ?_)
      · exact (natDegree_mul_le).trans (by rw [natDegree_X]; omega)
      · rw [hR]
        exact (natDegree_sum_le_of_forall_le T P fun β _ => hPdeg β).trans (by omega)
    · -- aeval
      have hRae : aeval x R =
          ∑ β ∈ T, sys.germAt β (A₀ * X ^ k) * sys.germAt (ξ - β) X := by
        rw [hR, map_sum]; exact Finset.sum_congr rfl fun β hβ => hPae β hβ
      rw [map_add, map_mul, aeval_X, hqξae, hRae, pow_succ, ← mul_assoc, E1, sys.germAt_zero X]
    · -- coeff (k+1)
      have hR1 : R.coeff (k + 1) = 0 := by
        rw [hR, finsetSum_coeff]; exact Finset.sum_eq_zero fun β _ => hPck1 β
      rw [coeff_add, coeff_mul_X, hR1, add_zero, hqξck]
    · -- coeff k
      intro _
      have hdiag : (↑((qξ * Polynomial.X).coeff k) : Q) =
          (k : ℕ) • (sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * x) := by
        rcases Nat.eq_zero_or_pos k with hk0 | hkpos
        · subst hk0; simp
        · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hkpos.ne'
          rw [coeff_mul_X]
          simpa using hqξck1 (Nat.succ_le_succ (Nat.zero_le m))
      have hRck : (↑(R.coeff k) : Q) = sys.germAt ξ (A₀ * X) - sys.germAt ξ A₀ * x := by
        rw [hR, finsetSum_coeff, AddSubmonoidClass.coe_finsetSum, hcsum]
        exact Finset.sum_congr rfl fun β hβ => hPck β hβ
      simp only [Nat.add_sub_cancel, coeff_add, Subalgebra.coe_add, hdiag, hRck, succ_nsmul]

open Polynomial in
/-- **Transcendence of a germ.** Let `S` be a subalgebra of the ring of germs that is an integral
domain and has representatives whose germs lie in `S`, and let `X` be a series whose germs at
negative exponents lie in `S` but whose germ `germ X` does not. Then `germ X` is transcendental
over `S`, and `S[germ X]` again has representatives whose germs lie in it. -/
@[blueprint "lem:transcendence"
  (phase := "Polynomial presentations")
  (title := "Transcendence lemma")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on $A$ with values in $Q$
    (\ref{def:germ-axioms}).  Let $S\subseteq Q$ be a $K$-subalgebra that is an
    integral domain and such that every element of $S$ is $[b]$ for some
    $b\in A$ with $g_\xi(b)\in S$ for all $\xi$.  Let $X\in A$ with
    $g_\xi(X)\in S$ for all $\xi<0$ and $x=[X]\notin S$.  Then $x$ is
    transcendental over $S$, and every element of the $K$-subalgebra $S[x]$ is
    $[b]$ for some $b\in A$ with $g_\xi(b)\in S[x]$ for all $\xi$.
  -/)
  (proof := /--
    The second assertion holds for $X$ and for representatives of elements of
    $S$, and is preserved by sums and, through the convolution formula, by
    products.  For the first, let $p\in S[T]$ be nonzero of minimal degree $d$
    with $p(x)=0$.  Then $d\ge1$, and $d=1$ is excluded by
    \ref{lem:no-linear-relations}.  Let $d\ge2$, lift the coefficients $p_k$ to
    $A_k\in A$ with all germs in $S$, and put $Y=\sum_kA_kX^k$.  Then $[Y]=0$,
    so $g_\xi(Y)=0$ for $\xi$ in some $(\varepsilon,0)$.  Expanding by the
    convolution formula, for $\xi\le0$ one has $g_\xi(A_kX^k)=q_{k,\xi}(x)$ for
    a polynomial $q_{k,\xi}\in S[T]$ of degree at most $k$ whose coefficient of
    $T^k$ is $g_\xi(A_k)$ and whose coefficient of $T^{k-1}$ is
    $k\,(g_\xi(A_kX)-g_\xi(A_k)\,x)$.  Put $q_\xi=\sum_kq_{k,\xi}$.  For
    $\xi\in(\varepsilon,0)$ the polynomial $p_d\,q_\xi-g_\xi(A_d)\,p$ vanishes at
    $x$ and has degree less than $d$, so it is $0$.  Its coefficient of
    $T^{d-1}$ says that $Z=dA_dX+A_{d-1}$ satisfies
    $[A_d]\,g_\xi(Z)=[Z]\,g_\xi(A_d)$ for $\xi\in(\varepsilon,0)$.  The germs of
    $A_d$ lie in $S$ and those of $Z$ in $S+Sx$, so by
    \ref{lem:proportionality} $[Z]=c\,p_d$ for some $c\in K$, that is,
    $d\,p_d\,x+p_{d-1}-c\,p_d=0$.  As $K$ has characteristic $0$, $d\,p_d\ne0$,
    and this relation of degree one contradicts minimality.
  -/)]
theorem transcendental_germ (S : Subalgebra K Q) [IsDomain S]
    (hS : sys.HasRepresentativesWithGermsIn S) (X : A)
    (hX : ∀ ξ < 0, sys.germAt ξ X ∈ S) (hx : sys.germ X ∉ S) :
    Transcendental S (sys.germ X) ∧
      sys.HasRepresentativesWithGermsIn (Algebra.adjoin K (insert (sys.germ X) (S : Set Q))) := by
  set x := sys.germ X with hxdef
  haveI : CharZero Q := charZero_of_injective_algebraMap (algebraMap K Q).injective
  haveI : CharZero ↥S := charZero_of_injective_algebraMap (algebraMap K ↥S).injective
  refine ⟨?_, sys.hasRepresentativesWithGermsIn_adjoin S hS X hX⟩
  rw [transcendental_iff]
  suffices H : ∀ (d : ℕ), ∀ p : Polynomial ↥S,
      p.natDegree = d → p ≠ 0 → aeval x p = 0 → False by
    intro p hp; by_contra hne; exact H p.natDegree p rfl hne hp
  intro d
  induction d using Nat.strongRecOn with
  | ind d IH =>
    intro p hpd hpne hpeval
    -- lift the coefficients of `p` to representatives with germs in `S`.
    set Afun : ℕ → A := fun k => Classical.choose (hS (↑(p.coeff k)) (p.coeff k).2) with hAfun
    have hAg : ∀ k, sys.germ (Afun k) = ↑(p.coeff k) :=
      fun k => (Classical.choose_spec (hS (↑(p.coeff k)) (p.coeff k).2)).1
    have hAs : ∀ k, ∀ ξ, sys.germAt ξ (Afun k) ∈ S :=
      fun k => (Classical.choose_spec (hS (↑(p.coeff k)) (p.coeff k).2)).2
    have had_ne : p.coeff d ≠ 0 := by
      rw [show p.coeff d = p.leadingCoeff by rw [leadingCoeff, hpd]]
      exact leadingCoeff_ne_zero.mpr hpne
    have hd1 : 1 ≤ d := by
      by_contra h
      have hd0 : d = 0 := by omega
      rw [hd0] at hpd
      apply hpne
      rw [eq_C_of_natDegree_eq_zero hpd, aeval_C, Subalgebra.algebraMap_apply] at hpeval
      rw [eq_C_of_natDegree_eq_zero hpd, (Subalgebra.coe_eq_zero S).mp hpeval, map_zero]
    rcases eq_or_lt_of_le hd1 with hd1eq | hd2
    · -- `d = 1`: direct contradiction via division closure.
      subst hd1eq
      have h2 := aeval_eq_sum_range' (show p.natDegree < 2 by omega) x
      rw [h2] at hpeval
      simp only [Finset.sum_range_succ, Finset.sum_range_zero, pow_zero, pow_one, zero_add,
        Algebra.smul_def, Subalgebra.algebraMap_apply, mul_one] at hpeval
      have hc1x : (↑(p.coeff 1) : Q) * x ∈ S := by
        have heq : (↑(p.coeff 1) : Q) * x = -↑(p.coeff 0) := by linear_combination hpeval
        rw [heq]; exact neg_mem (p.coeff 0).2
      have hc1ne : (↑(p.coeff 1) : Q) ≠ 0 := fun h => had_ne ((Subalgebra.coe_eq_zero S).mp h)
      exact sys.mul_germ_notMem S hS X hX hx (↑(p.coeff 1)) (p.coeff 1).2 hc1ne hc1x
    · -- `d ≥ 2`: derivative argument.
      obtain ⟨e, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (show d ≠ 0 by omega)
      set Y : A := ∑ k ∈ Finset.range (e + 2), Afun k * X ^ k with hY
      have hgermY : sys.germ Y = 0 := by
        have hYp : sys.germ Y = aeval x p := by
          rw [hY, map_sum, aeval_eq_sum_range, hpd]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [map_mul, map_pow, hAg k, ← hxdef, Algebra.smul_def, Subalgebra.algebraMap_apply]
        rw [hYp, hpeval]
      obtain ⟨ε₀, hε₀, hLY0⟩ :=
        sys.germAt_eventually_eq_zero Y ⟨0, by rw [map_zero, hgermY]⟩
      -- the auxiliary element `Z`.
      set Z : A := (e + 1) • (Afun (e + 1) * X) + Afun e with hZ
      have hLZ : ∀ ζ, sys.germAt ζ Z =
          (↑(e + 1) : Q) * sys.germAt ζ (Afun (e + 1) * X) + sys.germAt ζ (Afun e) := by
        intro ζ; rw [hZ, map_add, map_nsmul, nsmul_eq_mul]
      have hgZ : sys.germ Z =
          (↑(e + 1) : Q) * (sys.germ (Afun (e + 1)) * x) + sys.germ (Afun e) :=
        by rw [hZ, map_add, map_nsmul, map_mul, ← hxdef, nsmul_eq_mul]
      -- the proportionality relation on the interval `(ε₀, 0)`.
      have hrel : ∀ ζ, ε₀ < ζ → ζ < 0 →
          sys.germ (Afun (e + 1)) * sys.germAt ζ Z =
            sys.germ Z * sys.germAt ζ (Afun (e + 1)) := by
        intro ξ hlo hhi
        have hξ0 : ξ ≤ 0 := le_of_lt hhi
        have hLY : sys.germAt ξ Y = 0 := hLY0 ξ hlo hhi
        -- assemble the Taylor polynomial `taylorPoly` for `Y`.
        set qk : ℕ → Polynomial ↥S :=
          fun k => Classical.choose (sys.expansion S X hX (Afun k) (hAs k) k ξ hξ0) with hqk
        have hsp : ∀ k, (qk k).natDegree ≤ k ∧
            aeval x (qk k) = sys.germAt ξ (Afun k * X ^ k) ∧
            (↑((qk k).coeff k) : Q) = sys.germAt ξ (Afun k) ∧
            (1 ≤ k → (↑((qk k).coeff (k - 1)) : Q) =
              (k : ℕ) • (sys.germAt ξ (Afun k * X) - sys.germAt ξ (Afun k) * x)) :=
          fun k => Classical.choose_spec (sys.expansion S X hX (Afun k) (hAs k) k ξ hξ0)
        set taylorPoly : Polynomial ↥S := ∑ k ∈ Finset.range (e + 2), qk k with hQ
        have hQae : aeval x taylorPoly = sys.germAt ξ Y := by
          rw [hQ, map_sum, hY, map_sum]
          exact Finset.sum_congr rfl fun k _ => (hsp k).2.1
        have hQdeg : taylorPoly.natDegree ≤ e + 1 := by
          rw [hQ]
          refine natDegree_sum_le_of_forall_le _ _ fun k hk => (hsp k).1.trans ?_
          have := Finset.mem_range.mp hk; omega
        have hQcoeffd : (↑(taylorPoly.coeff (e + 1)) : Q) = sys.germAt ξ (Afun (e + 1)) := by
          rw [hQ, finsetSum_coeff, AddSubmonoidClass.coe_finsetSum,
            Finset.sum_eq_single_of_mem (e + 1) (Finset.mem_range.mpr (by omega))]
          · exact (hsp (e + 1)).2.2.1
          · intro k hk hkne
            have := Finset.mem_range.mp hk
            rw [coeff_eq_zero_of_natDegree_lt ((hsp k).1.trans_lt (by omega)),
              Subalgebra.coe_zero]
        have hQcoeffd1 : (↑(taylorPoly.coeff e) : Q) = sys.germAt ξ (Afun e) +
            (↑(e + 1) : Q) *
              (sys.germAt ξ (Afun (e + 1) * X) - sys.germAt ξ (Afun (e + 1)) * x) := by
          rw [hQ, finsetSum_coeff, AddSubmonoidClass.coe_finsetSum, Finset.sum_range_succ,
            Finset.sum_range_succ, Finset.sum_eq_zero, zero_add]
          · rw [(hsp e).2.2.1]
            have h2 := (hsp (e + 1)).2.2.2 (by omega)
            simp only [Nat.add_sub_cancel] at h2
            rw [h2, nsmul_eq_mul]
          · intro k hk
            have := Finset.mem_range.mp hk
            rw [coeff_eq_zero_of_natDegree_lt ((hsp k).1.trans_lt (by omega)), Subalgebra.coe_zero]
        -- the auxiliary polynomial `Pξ`, which must vanish by minimality.
        set Pξ : Polynomial ↥S :=
          C (p.coeff (e + 1)) * taylorPoly - C (taylorPoly.coeff (e + 1)) * p with hPξ
        have hPae : aeval x Pξ = 0 := by
          rw [hPξ, map_sub, map_mul, map_mul, aeval_C, aeval_C, Subalgebra.algebraMap_apply,
            Subalgebra.algebraMap_apply, hQae, hLY, hpeval, mul_zero, mul_zero, sub_zero]
        have hPcoeffd : Pξ.coeff (e + 1) = 0 := by
          rw [hPξ, coeff_sub, coeff_C_mul, coeff_C_mul, mul_comm (taylorPoly.coeff (e + 1)),
            sub_self]
        have hPdeg : Pξ.natDegree ≤ e + 1 := by
          rw [hPξ]
          refine (natDegree_sub_le _ _).trans (max_le ?_ ?_)
          · exact (natDegree_C_mul_le _ _).trans hQdeg
          · exact (natDegree_C_mul_le _ _).trans (le_of_eq hpd)
        by_cases hP0 : Pξ = 0
        · -- extract the subleading relation.
          have hPc : Pξ.coeff e = 0 := by rw [hP0, coeff_zero]
          rw [hPξ, coeff_sub, coeff_C_mul, coeff_C_mul] at hPc
          have hstar := congrArg (Subalgebra.val S) hPc
          simp only [map_sub, map_mul, map_zero, Subalgebra.coe_val] at hstar
          rw [← hAg (e + 1), ← hAg e, hQcoeffd1, hQcoeffd] at hstar
          rw [hgZ, hLZ ξ]
          linear_combination hstar
        · exfalso
          have hlt : Pξ.natDegree < e + 1 := by
            rcases lt_or_eq_of_le hPdeg with h | h
            · exact h
            · exfalso; apply hP0
              rw [← leadingCoeff_eq_zero, ← coeff_natDegree, h]; exact hPcoeffd
          exact IH Pξ.natDegree hlt Pξ rfl hP0 hPae
      -- feed the relation to proportionality and construct a degree-one killer.
      have hV : sys.germ (Afun (e + 1)) ≠ 0 := by
        rw [hAg (e + 1)]; exact fun h => had_ne ((Subalgebra.coe_eq_zero S).mp h)
      have hZN : ∀ ζ ≤ 0, ∃ s₀ ∈ S, ∃ s₁ ∈ S, sys.germAt ζ Z = s₀ + s₁ * x := by
        intro ζ _
        have hoff := sys.offDiagonal_mem S hX (Afun (e + 1)) (hAs (e + 1)) (ξ := ζ)
        have hn : ((e + 1 : ℕ) : Q) ∈ S := natCast_mem S (e + 1)
        refine ⟨(↑(e + 1) : Q) * (sys.germAt ζ (Afun (e + 1) * X) -
            sys.germAt ζ (Afun (e + 1)) * x) + sys.germAt ζ (Afun e),
          S.add_mem (S.mul_mem hn hoff) (hAs e ζ),
          (↑(e + 1) : Q) * sys.germAt ζ (Afun (e + 1)), S.mul_mem hn (hAs (e + 1) ζ), ?_⟩
        rw [hLZ ζ]; ring
      obtain ⟨c, hc⟩ := sys.exists_germ_eq_smul_of_proportional S
        (fun a ha ha0 => sys.mul_germ_notMem S hS X hX hx a ha ha0) Z (Afun (e + 1)) hV
        (fun ξ _ => hAs (e + 1) ξ) hZN ⟨ε₀, hε₀, hrel⟩
      have hne : (e + 1 : ↥S) ≠ 0 := Nat.cast_add_one_ne_zero e
      set r : Polynomial ↥S :=
        C ((e + 1 : ↥S) * p.coeff (e + 1)) * Polynomial.X +
          C (p.coeff e - c • p.coeff (e + 1)) with hr
      have hr_lead : (e + 1 : ↥S) * p.coeff (e + 1) ≠ 0 := mul_ne_zero hne had_ne
      have hr_deg : r.natDegree = 1 := natDegree_linear hr_lead
      have hr_ne : r ≠ 0 := by intro h; rw [h,
        natDegree_zero] at hr_deg; exact one_ne_zero hr_deg.symm
      have hr_ae : aeval x r = 0 := by
        have hval : aeval x r = sys.germ Z - c • sys.germ (Afun (e + 1)) := by
          rw [hr, map_add, map_mul, aeval_C, aeval_X, aeval_C, hgZ]
          simp only [map_mul, map_sub, map_natCast, map_add, map_one,
            Subalgebra.algebraMap_apply, hAg]
          push_cast
          ring
        rw [hval, hc, sub_self]
      exact IH 1 (by omega) r hr_deg hr_ne hr_ae

include sys in
/-- The ring of germs is a polynomial ring over `K`: it has an algebraically independent set of
generators. -/
@[blueprint "thm:germ-ring-generators"
  (phase := "Polynomial presentations")
  (title := "Algebraically independent generators of the ring of germs")
  (statement := /--
    Let $(g_\gamma)$ be a system of germs on $A$ with values in $Q$
    (\ref{def:germ-axioms}).  There is a set $T\subseteq Q$, algebraically
    independent over $K$, such that $K[T]=Q$.
  -/)
  (proof := /--
    By Zorn's lemma choose a maximal set $T\subseteq Q$, algebraically
    independent over $K$, such that every element of $K[T]$ is $[b]$ for some
    $b\in A$ with all germs in $K[T]$; the empty set qualifies because a scalar
    $k$ has $g_\xi(k)=0$ for $\xi\ne0$, and the union of a chain qualifies.
    $K[T]$ is a polynomial ring, hence an integral domain.  Suppose
    $K[T]\ne Q$ and choose $x\notin K[T]$ of minimal rank; then $x\notin K$.
    Represent $x$ by $X_0$, choose $\varepsilon<0$ with
    $\operatorname{rk}g_\xi(X_0)<\operatorname{rk}x$ for $\xi\in(\varepsilon,0)$
    by axiom (5), and use axiom (7) to replace $X_0$ by a series $X$ with the
    same germ, the same germs on $(\varepsilon,0)$, and no germs at or below
    $\varepsilon$.  By minimality of $x$, all germs of $X$ at negative exponents
    lie in $K[T]$.  By \ref{lem:transcendence}, $x$ is transcendental over
    $K[T]$ and $K[T][x]$ again has the representative property, so
    $T\cup\{x\}$ contradicts the maximality of $T$.
  -/)]
theorem exists_algebraicIndependent_generators :
    ∃ T : Set Q, AlgebraicIndependent K ((↑) : T → Q) ∧ Algebra.adjoin K T = ⊤ := by
  -- Run Zorn's lemma on algebraically independent sets whose adjoin is stable.
  have hEmptyMem : (∅ : Set Q) ∈ {T : Set Q | AlgebraicIndependent K ((↑) : T → Q) ∧
      sys.HasRepresentativesWithGermsIn (Algebra.adjoin K T)} :=
    ⟨algebraicIndependent_empty_type,
      by rw [Algebra.adjoin_empty]; exact sys.hasRepresentativesWithGermsIn_bot⟩
  have H : ∀ c ⊆ {T : Set Q | AlgebraicIndependent K ((↑) : T → Q) ∧
        sys.HasRepresentativesWithGermsIn (Algebra.adjoin K T)},
      IsChain (· ⊆ ·) c → c.Nonempty →
      ∃ ub ∈ {T : Set Q | AlgebraicIndependent K ((↑) : T → Q) ∧
        sys.HasRepresentativesWithGermsIn (Algebra.adjoin K T)}, ∀ s ∈ c, s ⊆ ub := by
    intro c hc chainc hcn
    refine ⟨⋃₀ c, ⟨?_, ?_⟩, fun s hs => Set.subset_sUnion_of_mem hs⟩
    · exact algebraicIndependent_sUnion_of_directed hcn chainc.directedOn fun s hs => (hc hs).1
    · intro a ha
      haveI : Nonempty ↥c := hcn.to_subtype
      have hdir : Directed (· ≤ ·) fun s : c => Algebra.adjoin K (s : Set Q) := by
        rintro ⟨s, hs⟩ ⟨t, ht⟩
        rcases chainc.total hs ht with hst | hts
        · exact ⟨⟨t, ht⟩, Algebra.adjoin_mono hst, le_rfl⟩
        · exact ⟨⟨s, hs⟩, le_rfl, Algebra.adjoin_mono hts⟩
      have hcoe : (↑(Algebra.adjoin K (⋃₀ c)) : Set Q) =
          ⋃ s : c, (Algebra.adjoin K (s : Set Q) : Set Q) := by
        rw [Set.sUnion_eq_iUnion, Algebra.adjoin_iUnion]
        exact Subalgebra.coe_iSup_of_directed hdir
      have ha' : a ∈ (↑(Algebra.adjoin K (⋃₀ c)) : Set Q) := ha
      rw [hcoe, Set.mem_iUnion] at ha'
      obtain ⟨s, has⟩ := ha'
      obtain ⟨b, hbg, hbs⟩ := (hc s.2).2 a has
      exact ⟨b, hbg, fun ξ => Algebra.adjoin_mono (Set.subset_sUnion_of_mem s.2) (hbs ξ)⟩
  obtain ⟨T, -, hTmax⟩ := zorn_subset_nonempty _ H ∅ hEmptyMem
  obtain ⟨hTind, hTstab⟩ := hTmax.1
  refine ⟨T, hTind, ?_⟩
  -- The maximal stable independent set generates everything.
  set S := Algebra.adjoin K T with hSdef
  by_contra hSne
  -- Choose an element outside `S` of minimal rank.
  obtain ⟨g₀, hg₀⟩ : ∃ g : Q, g ∉ S := by
    by_contra h
    exact hSne (Algebra.eq_top_iff.mpr fun x => not_not.mp fun hx => h ⟨x, hx⟩)
  have hwf : WellFounded fun a b : Q => sys.rank a < sys.rank b :=
    InvImage.wf sys.rank Ordinal.lt_wf
  obtain ⟨x, hxnotS, hxmin⟩ := hwf.has_min {g : Q | g ∉ S} ⟨g₀, hg₀⟩
  have hmin : ∀ y : Q, sys.rank y < sys.rank x → y ∈ S := by
    intro y hy
    by_contra hyS
    exact hxmin y hyS hy
  have hxnc : x ∉ Set.range (algebraMap K Q) := by
    rintro ⟨k, rfl⟩
    exact hxnotS (Subalgebra.algebraMap_mem S k)
  -- Lift to a series, truncate below the rank-drop threshold.
  obtain ⟨X₀, hX₀⟩ := sys.germ_surjective x
  obtain ⟨ε, hε, hdrop⟩ := sys.rank_germAt_lt X₀ (by rw [hX₀]; exact hxnc)
  obtain ⟨X, hXg, hXeq, hXvan⟩ := sys.exists_cutoff X₀ ε hε
  have hXgerm : ∀ ξ < 0, sys.germAt ξ X ∈ S := by
    intro ξ hξ
    rcases le_or_gt ξ ε with hξε | hεξ
    · rw [hXvan ξ hξε]; exact zero_mem S
    · rw [hXeq ξ hεξ]
      refine hmin (sys.germAt ξ X₀) ?_
      have := hdrop ξ hεξ hξ
      rwa [hX₀] at this
  have hgXeq : sys.germ X = x := by rw [hXg]; exact hX₀
  have hxX : sys.germ X ∉ S := by rw [hgXeq]; exact hxnotS
  -- The germ of `X` is transcendental over `S`, so adjoining it enlarges the set.
  haveI : IsDomain S := hTind.isDomain_adjoin
  obtain ⟨htrans, hstabSx⟩ := sys.transcendental_germ S hTstab X hXgerm hxX
  have hind' : AlgebraicIndependent K ((↑) : (insert (sys.germ X) T : Set Q) → Q) := by
    have := AlgebraicIndepOn.insert (R := K) (x := (id : Q → Q)) (s := T)
      (i := sys.germ X) hTind (by rw [Set.image_id]; exact htrans)
    exact this
  have hSeq : Algebra.adjoin K (insert (sys.germ X) T) =
      Algebra.adjoin K (insert (sys.germ X) (S : Set Q)) := by
    apply le_antisymm
    · exact Algebra.adjoin_mono (Set.insert_subset_insert Algebra.subset_adjoin)
    · apply Algebra.adjoin_le
      rw [Set.insert_subset_iff]
      refine ⟨Algebra.subset_adjoin (Set.mem_insert _ _),
        fun a ha => Algebra.adjoin_mono (Set.subset_insert (sys.germ X) T) ha⟩
  have hT'mem : insert (sys.germ X) T ∈ {T : Set Q | AlgebraicIndependent K ((↑) : T → Q) ∧
      sys.HasRepresentativesWithGermsIn (Algebra.adjoin K T)} := ⟨hind',
        by rw [hSeq]; exact hstabSx⟩
  have hsub : insert (sys.germ X) T ⊆ T := hTmax.2 hT'mem (Set.subset_insert _ _)
  exact hxX (Algebra.subset_adjoin (hsub (Set.mem_insert _ _)))

end TruncationGerms

namespace TruncationGerms

variable {K Γ : Type*} [Field K] [CharZero K]
  [AddCommGroup Γ] [LinearOrder Γ] [IsOrderedAddMonoid Γ]

/-- The ring of germs `Q` is isomorphic to a polynomial ring over `K`. The universe of the
variables may be enlarged freely. -/
theorem exists_mvPolynomial_algEquiv {Q : Type u} [CommRing Q] [Nontrivial Q] [Algebra K Q]
    {A : Type*} [CommRing A] [Algebra K A] (sys : TruncationGerms K Γ A Q) :
    ∃ ι : Type (max u w), Nonempty (MvPolynomial ι K ≃ₐ[K] Q) := by
  obtain ⟨T, hind, htop⟩ := sys.exists_algebraicIndependent_generators
  exact ⟨ULift.{w} T, ⟨(MvPolynomial.renameEquiv K Equiv.ulift).trans
    (hind.mvPolynomialAlgEquivOfAdjoinEqTop htop)⟩⟩

/-- The ring of germs is an integral domain, being a polynomial ring over a field. -/
theorem isDomain {Q : Type*} [CommRing Q] [Nontrivial Q] [Algebra K Q]
    {A : Type*} [CommRing A] [Algebra K A] (sys : TruncationGerms K Γ A Q) : IsDomain Q := by
  obtain ⟨T, hind, htop⟩ := sys.exists_algebraicIndependent_generators
  exact (hind.mvPolynomialAlgEquivOfAdjoinEqTop htop).symm.toMulEquiv.isDomain _

end TruncationGerms

